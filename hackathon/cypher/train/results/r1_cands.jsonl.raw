{"id": "tr309", "cands": [{"raw": "MATCH (mentionedUser:User {screen_name: \"neo4j\"})\nMATCH (tweet:Tweet)-[:MENTIONS]->(mentionedUser)\nMATCH (author:User)-[:POSTS]->(tweet)\nWITH avg(author.followers) AS averageFollowers\nRETURN averageFollowers<|eot|>", "text": "MATCH (mentionedUser:User {screen_name: \"neo4j\"})\nMATCH (tweet:Tweet)-[:MENTIONS]->(mentionedUser)\nMATCH (author:User)-[:POSTS]->(tweet)\nWITH avg(author.followers) AS averageFollowers\nRETURN averageFollowers", "out_tokens": 57, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: \"neo4j\"})\nMATCH (t:Tweet)-[:MENTIONS]->(u)\nMATCH (author:User)-[:POSTS]->(t)\nWITH avg(author.followers) AS average_followers\nRETURN average_followers<|eot|>", "text": "MATCH (u:User {screen_name: \"neo4j\"})\nMATCH (t:Tweet)-[:MENTIONS]->(u)\nMATCH (author:User)-[:POSTS]->(t)\nWITH avg(author.followers) AS average_followers\nRETURN average_followers", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: \"neo4j\"})\nMATCH (u)<-[:MENTIONS]-(tweet:Tweet)<-[:POSTS]-(postUser:User)\nWITH avg(postUser.followers) AS averageFollowers\nRETURN averageFollowers<|eot|>", "text": "MATCH (u:User {screen_name: \"neo4j\"})\nMATCH (u)<-[:MENTIONS]-(tweet:Tweet)<-[:POSTS]-(postUser:User)\nWITH avg(postUser.followers) AS averageFollowers\nRETURN averageFollowers", "out_tokens": 53, "stop": "stop"}, {"raw": "MATCH (targetUser:User {screen_name: \"neo4j\"})\nMATCH (tweet:Tweet)-[:MENTIONS]->(targetUser)\nMATCH (tweet)<-[:POSTS]-(user:User)\nWITH avg(user.followers) AS averageFollowers\nRETURN averageFollowers<|eot|>", "text": "MATCH (targetUser:User {screen_name: \"neo4j\"})\nMATCH (tweet:Tweet)-[:MENTIONS]->(targetUser)\nMATCH (tweet)<-[:POSTS]-(user:User)\nWITH avg(user.followers) AS averageFollowers\nRETURN averageFollowers", "out_tokens": 56, "stop": "stop"}], "in_tokens": 844, "api_error": null}
