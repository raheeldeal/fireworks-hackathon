{"id": "tr311", "cands": [{"raw": "MATCH (m:Movie)\nWHERE size(split(m.tagline, ' ')) > 10\nMATCH (p:Person)-[r:REVIEWED]->(m)\nWITH avg(r.rating) AS averageRating\nRETURN averageRating<|eot|>", "text": "MATCH (m:Movie)\nWHERE size(split(m.tagline, ' ')) > 10\nMATCH (p:Person)-[r:REVIEWED]->(m)\nWITH avg(r.rating) AS averageRating\nRETURN averageRating", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[r:REVIEWED]-()\nWHERE size(split(m.tagline, ' ')) > 10\nWITH avg(r.rating) AS average_rating\nRETURN average_rating<|eot|>", "text": "MATCH (m:Movie)<-[r:REVIEWED]-()\nWHERE size(split(m.tagline, ' ')) > 10\nWITH avg(r.rating) AS average_rating\nRETURN average_rating", "out_tokens": 40, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[r:REVIEWED]-()\nWHERE size(split(m.tagline, ' ')) > 10\nRETURN avg(r.rating) AS average_rating<|eot|>", "text": "MATCH (m:Movie)<-[r:REVIEWED]-()\nWHERE size(split(m.tagline, ' ')) > 10\nRETURN avg(r.rating) AS average_rating", "out_tokens": 36, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE size(split(m.tagline, ' ')) > 10\nMATCH (p:Person)-[r:REVIEWED]->(m)\nWITH avg(r.rating) AS average_rating\nRETURN average_rating<|eot|>", "text": "MATCH (m:Movie)\nWHERE size(split(m.tagline, ' ')) > 10\nMATCH (p:Person)-[r:REVIEWED]->(m)\nWITH avg(r.rating) AS average_rating\nRETURN average_rating", "out_tokens": 48, "stop": "stop"}], "in_tokens": 380, "api_error": null}
{"id": "tr312", "cands": [{"raw": "MATCH (a:Actor)-[r:ACTED_IN]->(m:Movie)\nWHERE a.born < date(datetime({epochMillis: apoc.date.parse(m.released, 'ms', 'yyyy-MM-dd')}).epochMillis - 50 * 365 * 24 * 60 * 60 * 1000)\nRETURN m.title, m.released, a.name, a.born\nORDER BY m.released\nLIMIT 3<|eot|>", "text": "MATCH (a:Actor)-[r:ACTED_IN]->(m:Movie)\nWHERE a.born < date(datetime({epochMillis: apoc.date.parse(m.released, 'ms', 'yyyy-MM-dd')}).epochMillis - 50 * 365 * 24 * 60 * 60 * 1000)\nRETURN m.title, m.released, a.name, a.born\nORDER BY m.released\nLIMIT 3", "out_tokens": 92, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[:ACTED_IN]-(a:Actor)\nWHERE a.born IS NOT NULL AND m.released IS NOT NULL\nWITH m, a, duration.inYears(a.born, date(m.released)).years AS age\nWHERE age > 50\nRETURN m.title, m.released, a.name, age\nORDER BY m.released\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)<-[:ACTED_IN]-(a:Actor)\nWHERE a.born IS NOT NULL AND m.released IS NOT NULL\nWITH m, a, duration.inYears(a.born, date(m.released)).years AS age\nWHERE age > 50\nRETURN m.title, m.released, a.name, age\nORDER BY m.released\nLIMIT 3", "out_tokens": 81, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[:ACTED_IN]-(a:Actor)\nWHERE a.born IS NOT NULL AND a.born <= date(datetime({epochMillis: apoc.date.parse(m.released, 'ms', 'yyyy-MM-dd')}) - duration({years: 50}))\nRETURN m.title AS movieTitle, a.name AS actorName, a.born AS actorBirthDate\nORDER BY m.released\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)<-[:ACTED_IN]-(a:Actor)\nWHERE a.born IS NOT NULL AND a.born <= date(datetime({epochMillis: apoc.date.parse(m.released, 'ms', 'yyyy-MM-dd')}) - duration({years: 50}))\nRETURN m.title AS movieTitle, a.name AS actorName, a.born AS actorBirthDate\nORDER BY m.released\nLIMIT 3", "out_tokens": 90, "stop": "stop"}, {"raw": "MATCH (a:Actor)-[r:ACTED_IN]->(m:Movie)\nWHERE a.born <= date(datetime({epochMillis: apoc.date.parse(m.released, 'ms', 'yyyy-MM-dd')}) - duration({years: 50}))\nRETURN m.title, m.released, a.name, a.born\nORDER BY m.released\nLIMIT 3<|eot|>", "text": "MATCH (a:Actor)-[r:ACTED_IN]->(m:Movie)\nWHERE a.born <= date(datetime({epochMillis: apoc.date.parse(m.released, 'ms', 'yyyy-MM-dd')}) - duration({years: 50}))\nRETURN m.title, m.released, a.name, a.born\nORDER BY m.released\nLIMIT 3", "out_tokens": 78, "stop": "stop"}], "in_tokens": 1099, "api_error": null}
{"id": "tr313", "cands": [{"raw": "MATCH (m:Movie {title: 'Toy Story'})<-[r:RATED]-(u:User)\nWITH u, r.rating AS rating\nORDER BY rating DESC\nRETURN u.name AS userName, rating\nLIMIT 1<|eot|>", "text": "MATCH (m:Movie {title: 'Toy Story'})<-[r:RATED]-(u:User)\nWITH u, r.rating AS rating\nORDER BY rating DESC\nRETURN u.name AS userName, rating\nLIMIT 1", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (m:Movie {title: \"Toy Story\"})<-[r:RATED]-(u:User)\nWITH m, max(r.rating) AS maxRating\nMATCH (m)<-[r:RATED]-(u:User)\nWHERE r.rating = maxRating\nRETURN u.name<|eot|>", "text": "MATCH (m:Movie {title: \"Toy Story\"})<-[r:RATED]-(u:User)\nWITH m, max(r.rating) AS maxRating\nMATCH (m)<-[r:RATED]-(u:User)\nWHERE r.rating = maxRating\nRETURN u.name", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (m:Movie {title: \"Toy Story\"})<-[r:RATED]-(u:User)\nWITH m, max(r.rating) AS maxRating\nMATCH (m)<-[r:RATED]-(u:User)\nWHERE r.rating = maxRating\nRETURN u.name<|eot|>", "text": "MATCH (m:Movie {title: \"Toy Story\"})<-[r:RATED]-(u:User)\nWITH m, max(r.rating) AS maxRating\nMATCH (m)<-[r:RATED]-(u:User)\nWHERE r.rating = maxRating\nRETURN u.name", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (m:Movie {title: 'Toy Story'})<-[r:RATED]-(u:User)\nWITH m, r, u, r.rating AS rating\nORDER BY rating DESC\nRETURN u.name AS userName, rating\nLIMIT 1<|eot|>", "text": "MATCH (m:Movie {title: 'Toy Story'})<-[r:RATED]-(u:User)\nWITH m, r, u, r.rating AS rating\nORDER BY rating DESC\nRETURN u.name AS userName, rating\nLIMIT 1", "out_tokens": 52, "stop": "stop"}], "in_tokens": 1095, "api_error": null}
