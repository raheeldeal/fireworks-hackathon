{"id": "tr019", "cands": [{"raw": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE m.year < 1980\nRETURN u.name, m.title, r.rating\nORDER BY r.timestamp\nLIMIT 3<|eot|>", "text": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE m.year < 1980\nRETURN u.name, m.title, r.rating\nORDER BY r.timestamp\nLIMIT 3", "out_tokens": 42, "stop": "stop"}, {"raw": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE m.released < '1980-01-01'\nRETURN u.name, u.userId, COUNT(r) AS ratingsCount\nORDER BY ratingsCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE m.released < '1980-01-01'\nRETURN u.name, u.userId, COUNT(r) AS ratingsCount\nORDER BY ratingsCount DESC\nLIMIT 3", "out_tokens": 53, "stop": "stop"}, {"raw": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE m.year < 1980\nRETURN u.name AS userName, m.title AS movieTitle, m.year AS movieYear, r.rating AS rating\nORDER BY r.timestamp ASC\nLIMIT 3<|eot|>", "text": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE m.year < 1980\nRETURN u.name AS userName, m.title AS movieTitle, m.year AS movieYear, r.rating AS rating\nORDER BY r.timestamp ASC\nLIMIT 3", "out_tokens": 57, "stop": "stop"}, {"raw": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE m.year < 1980\nRETURN u.name AS userName, r.rating AS rating\nORDER BY r.timestamp\nLIMIT 3<|eot|>", "text": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE m.year < 1980\nRETURN u.name AS userName, r.rating AS rating\nORDER BY r.timestamp\nLIMIT 3", "out_tokens": 44, "stop": "stop"}], "in_tokens": 1092, "api_error": null}
{"id": "tr020", "cands": [{"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})<-[:FOLLOWS]-(user:User)-[:POSTS]->(tweet:Tweet)\nWITH avg(tweet.favorites) AS average_favorites\nRETURN average_favorites<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})<-[:FOLLOWS]-(user:User)-[:POSTS]->(tweet:Tweet)\nWITH avg(tweet.favorites) AS average_favorites\nRETURN average_favorites", "out_tokens": 53, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})<-[:FOLLOWS]-(follower:User)-[:POSTS]->(tweet:Tweet)\nWITH avg(tweet.favorites) AS average_favorites\nRETURN average_favorites<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})<-[:FOLLOWS]-(follower:User)-[:POSTS]->(tweet:Tweet)\nWITH avg(tweet.favorites) AS average_favorites\nRETURN average_favorites", "out_tokens": 52, "stop": "stop"}, {"raw": "MATCH (n:User {screen_name: 'neo4j'})<-[:FOLLOWS]-(follower:User)-[:POSTS]->(t:Tweet)\nWITH avg(t.favorites) AS average_favorites\nRETURN average_favorites<|eot|>", "text": "MATCH (n:User {screen_name: 'neo4j'})<-[:FOLLOWS]-(follower:User)-[:POSTS]->(t:Tweet)\nWITH avg(t.favorites) AS average_favorites\nRETURN average_favorites", "out_tokens": 51, "stop": "stop"}, {"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})<-[:FOLLOWS]-(user:User)-[:POSTS]->(tweet:Tweet)\nWITH avg(tweet.favorites) AS averageFavorites\nRETURN averageFavorites<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})<-[:FOLLOWS]-(user:User)-[:POSTS]->(tweet:Tweet)\nWITH avg(tweet.favorites) AS averageFavorites\nRETURN averageFavorites", "out_tokens": 51, "stop": "stop"}], "in_tokens": 837, "api_error": null}
{"id": "tr021", "cands": [{"raw": "MATCH (actor:Actor)-[:ACTED_IN]->(movie:Movie)<-[r:RATED]-(user:User)\nWITH actor, avg(r.rating) AS averageRating\nORDER BY averageRating DESC\nRETURN actor.name AS actorName, averageRating\nLIMIT 1<|eot|>", "text": "MATCH (actor:Actor)-[:ACTED_IN]->(movie:Movie)<-[r:RATED]-(user:User)\nWITH actor, avg(r.rating) AS averageRating\nORDER BY averageRating DESC\nRETURN actor.name AS actorName, averageRating\nLIMIT 1", "out_tokens": 56, "stop": "stop"}, {"raw": "MATCH (a:Actor)-[:ACTED_IN]->(m:Movie)<-[r:RATED]-()\nWITH a, avg(r.rating) AS avgRating\nRETURN a.name AS actor, avgRating\nORDER BY avgRating DESC\nLIMIT 1<|eot|>", "text": "MATCH (a:Actor)-[:ACTED_IN]->(m:Movie)<-[r:RATED]-()\nWITH a, avg(r.rating) AS avgRating\nRETURN a.name AS actor, avgRating\nORDER BY avgRating DESC\nLIMIT 1", "out_tokens": 51, "stop": "stop"}, {"raw": "MATCH (a:Actor)-[:ACTED_IN]->(m:Movie)<-[r:RATED]-(u:User)\nWITH a, avg(r.rating) AS avgRating\nORDER BY avgRating DESC\nRETURN a.name AS actor, avgRating\nLIMIT 1<|eot|>", "text": "MATCH (a:Actor)-[:ACTED_IN]->(m:Movie)<-[r:RATED]-(u:User)\nWITH a, avg(r.rating) AS avgRating\nORDER BY avgRating DESC\nRETURN a.name AS actor, avgRating\nLIMIT 1", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (a:Actor)-[:ACTED_IN]->(m:Movie)<-[r:RATED]-()\nWITH a, avg(r.rating) AS avgRating\nRETURN a.name AS actor, avgRating\nORDER BY avgRating DESC\nLIMIT 1<|eot|>", "text": "MATCH (a:Actor)-[:ACTED_IN]->(m:Movie)<-[r:RATED]-()\nWITH a, avg(r.rating) AS avgRating\nRETURN a.name AS actor, avgRating\nORDER BY avgRating DESC\nLIMIT 1", "out_tokens": 51, "stop": "stop"}], "in_tokens": 1085, "api_error": null}
