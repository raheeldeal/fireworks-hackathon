{"id": "tr333", "cands": [{"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWITH floor(p.born / 10) * 10 AS decade, count(DISTINCT m) AS moviesDirected, count(DISTINCT p) AS numDirectors\nWITH decade, sum(moviesDirected) AS totalMovies, sum(numDirectors) AS totalDirectors\nRETURN decade, totalMovies / totalDirectors AS averageMoviesPerDirector<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWITH floor(p.born / 10) * 10 AS decade, count(DISTINCT m) AS moviesDirected, count(DISTINCT p) AS numDirectors\nWITH decade, sum(moviesDirected) AS totalMovies, sum(numDirectors) AS totalDirectors\nRETURN decade, totalMovies / totalDirectors AS averageMoviesPerDirector", "out_tokens": 87, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWITH floor(p.born / 10) * 10 AS decade, count(DISTINCT m) AS moviesDirected\nWITH decade, avg(moviesDirected) AS averageMovies\nRETURN decade, averageMovies<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWITH floor(p.born / 10) * 10 AS decade, count(DISTINCT m) AS moviesDirected\nWITH decade, avg(moviesDirected) AS averageMovies\nRETURN decade, averageMovies", "out_tokens": 57, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWITH floor(p.born / 10) * 10 AS decade, count(DISTINCT m) AS moviesDirected, collect(DISTINCT p) AS directors\nRETURN decade, avg(toFloat(moviesDirected) / size(directors)) AS averageMoviesPerDirector<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWITH floor(p.born / 10) * 10 AS decade, count(DISTINCT m) AS moviesDirected, collect(DISTINCT p) AS directors\nRETURN decade, avg(toFloat(moviesDirected) / size(directors)) AS averageMoviesPerDirector", "out_tokens": 70, "stop": "stop"}, {"raw": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWITH floor(d.born / 10) * 10 AS decade, count(DISTINCT m) AS moviesDirected, count(DISTINCT d) AS numDirectors\nRETURN decade, toFloat(moviesDirected) / numDirectors AS avgMoviesPerDirector<|eot|>", "text": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWITH floor(d.born / 10) * 10 AS decade, count(DISTINCT m) AS moviesDirected, count(DISTINCT d) AS numDirectors\nRETURN decade, toFloat(moviesDirected) / numDirectors AS avgMoviesPerDirector", "out_tokens": 69, "stop": "stop"}], "in_tokens": 378, "api_error": null}
