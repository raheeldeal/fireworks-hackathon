{"id": "tr198", "cands": [{"raw": "MATCH (f:Filing)\nWHERE f.amount > 100000\nMATCH (f)-[:ORIGINATOR]->(e1:Entity)\nMATCH (f)-[:BENEFITS]->(e2:Entity)\nWITH e1, e2\nWHERE e1.id = e2.id\nRETURN DISTINCT e1.name<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.amount > 100000\nMATCH (f)-[:ORIGINATOR]->(e1:Entity)\nMATCH (f)-[:BENEFITS]->(e2:Entity)\nWITH e1, e2\nWHERE e1.id = e2.id\nRETURN DISTINCT e1.name", "out_tokens": 65, "stop": "stop"}, {"raw": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWHERE f.amount > 100000\nAND EXISTS { (:Entity)-[:ORIGINATOR]->(f) AND (:Entity)-[:BENEFITS]->(f) }\nRETURN DISTINCT e.name<|eot|>", "text": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWHERE f.amount > 100000\nAND EXISTS { (:Entity)-[:ORIGINATOR]->(f) AND (:Entity)-[:BENEFITS]->(f) }\nRETURN DISTINCT e.name", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (e:Entity)\nWHERE EXISTS { (e)-[:ORIGINATOR]->(:Filing {amount: > 100000}) } \nAND EXISTS { (e)-[:BENEFITS]->(:Filing {amount: > 100000}) }\nRETURN e.name<|eot|>", "text": "MATCH (e:Entity)\nWHERE EXISTS { (e)-[:ORIGINATOR]->(:Filing {amount: > 100000}) } \nAND EXISTS { (e)-[:BENEFITS]->(:Filing {amount: > 100000}) }\nRETURN e.name", "out_tokens": 56, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)\nMATCH (f)-[:BENEFITS]->(e)\nWHERE f.amount > 100000\nRETURN DISTINCT e.name<|eot|>", "text": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)\nMATCH (f)-[:BENEFITS]->(e)\nWHERE f.amount > 100000\nRETURN DISTINCT e.name", "out_tokens": 40, "stop": "stop"}], "in_tokens": 733, "api_error": null}
