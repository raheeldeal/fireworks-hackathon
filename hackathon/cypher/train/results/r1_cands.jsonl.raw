{"id": "tr157", "cands": [{"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWITH s, avg(p.unitsInStock) AS AvgUnitsInStock\nORDER BY AvgUnitsInStock DESC\nRETURN s.companyName AS Supplier, AvgUnitsInStock\nLIMIT 3<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWITH s, avg(p.unitsInStock) AS AvgUnitsInStock\nORDER BY AvgUnitsInStock DESC\nRETURN s.companyName AS Supplier, AvgUnitsInStock\nLIMIT 3", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nRETURN s.companyName AS supplier, avg(p.unitsInStock) AS averageUnitsInStock\nORDER BY averageUnitsInStock DESC\nLIMIT 3<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nRETURN s.companyName AS supplier, avg(p.unitsInStock) AS averageUnitsInStock\nORDER BY averageUnitsInStock DESC\nLIMIT 3", "out_tokens": 46, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWITH s, avg(p.unitsInStock) AS averageUnitsInStock\nORDER BY averageUnitsInStock DESC\nLIMIT 3\nRETURN s.companyName, averageUnitsInStock<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWITH s, avg(p.unitsInStock) AS averageUnitsInStock\nORDER BY averageUnitsInStock DESC\nLIMIT 3\nRETURN s.companyName, averageUnitsInStock", "out_tokens": 52, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWITH s, avg(p.unitsInStock) AS averageUnitsInStock\nRETURN s.companyName, averageUnitsInStock\nORDER BY averageUnitsInStock DESC\nLIMIT 3<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWITH s, avg(p.unitsInStock) AS averageUnitsInStock\nRETURN s.companyName, averageUnitsInStock\nORDER BY averageUnitsInStock DESC\nLIMIT 3", "out_tokens": 52, "stop": "stop"}], "in_tokens": 1258, "api_error": null}
{"id": "tr158", "cands": [{"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, count(p) AS numProducts\nORDER BY numProducts DESC\nRETURN s.companyName AS Supplier, numProducts\nLIMIT 1<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, count(p) AS numProducts\nORDER BY numProducts DESC\nRETURN s.companyName AS Supplier, numProducts\nLIMIT 1", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, count(p) AS productsInStock\nORDER BY productsInStock DESC\nRETURN s.companyName, productsInStock\nLIMIT 1<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, count(p) AS productsInStock\nORDER BY productsInStock DESC\nRETURN s.companyName, productsInStock\nLIMIT 1", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, count(p) AS productCount\nORDER BY productCount DESC\nRETURN s.companyName, productCount\nLIMIT 1<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, count(p) AS productCount\nORDER BY productCount DESC\nRETURN s.companyName, productCount\nLIMIT 1", "out_tokens": 52, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, count(p) AS productsInStock\nORDER BY productsInStock DESC\nLIMIT 1\nRETURN s.companyName AS supplierName, productsInStock<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, count(p) AS productsInStock\nORDER BY productsInStock DESC\nLIMIT 1\nRETURN s.companyName AS supplierName, productsInStock", "out_tokens": 58, "stop": "stop"}], "in_tokens": 1259, "api_error": null}
{"id": "tr159", "cands": [{"raw": "MATCH (o:Order)-[o_rel:ORDERS]->(p:Product)\nWITH o, sum(toFloat(o_rel.quantity) * toFloat(o_rel.unitPrice)) AS totalOrderValue\nWITH o, totalOrderValue\nORDER BY totalOrderValue DESC\nLIMIT 1\nMATCH (c:Customer)-[:PURCHASED]->(o)\nRETURN c.companyName AS customerName, totalOrderValue<|eot|>", "text": "MATCH (o:Order)-[o_rel:ORDERS]->(p:Product)\nWITH o, sum(toFloat(o_rel.quantity) * toFloat(o_rel.unitPrice)) AS totalOrderValue\nWITH o, totalOrderValue\nORDER BY totalOrderValue DESC\nLIMIT 1\nMATCH (c:Customer)-[:PURCHASED]->(o)\nRETURN c.companyName AS customerName, totalOrderValue", "out_tokens": 85, "stop": "stop"}, {"raw": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[rel:ORDERS]->(p:Product)\nWITH c, o, SUM(toFloat(rel.quantity) * toFloat(rel.unitPrice)) AS totalValue\nORDER BY totalValue DESC\nRETURN c.customerID, totalValue\nLIMIT 1;<|eot|>", "text": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[rel:ORDERS]->(p:Product)\nWITH c, o, SUM(toFloat(rel.quantity) * toFloat(rel.unitPrice)) AS totalValue\nORDER BY totalValue DESC\nRETURN c.customerID, totalValue\nLIMIT 1;", "out_tokens": 68, "stop": "stop"}, {"raw": "MATCH (o:Order)-[:ORDERS]->(p:Product)\nWITH o, sum(toFloat(p.unitPrice) * p.quantity) AS orderTotal\nWITH o, orderTotal\nORDER BY orderTotal DESC\nLIMIT 1\nMATCH (o)<-[:PURCHASED]-(c:Customer)\nRETURN c.companyName, orderTotal<|eot|>", "text": "MATCH (o:Order)-[:ORDERS]->(p:Product)\nWITH o, sum(toFloat(p.unitPrice) * p.quantity) AS orderTotal\nWITH o, orderTotal\nORDER BY orderTotal DESC\nLIMIT 1\nMATCH (o)<-[:PURCHASED]-(c:Customer)\nRETURN c.companyName, orderTotal", "out_tokens": 72, "stop": "stop"}, {"raw": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[rel:ORDERS]->(p:Product)\nWITH c, o, sum(toFloat(rel.quantity) * toFloat(rel.unitPrice)) AS orderTotal\nWITH o, orderTotal, max(orderTotal) AS maxTotal\nWHERE orderTotal = maxTotal\nRETURN c.companyName AS customerName, maxTotal AS orderValue<|eot|>", "text": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[rel:ORDERS]->(p:Product)\nWITH c, o, sum(toFloat(rel.quantity) * toFloat(rel.unitPrice)) AS orderTotal\nWITH o, orderTotal, max(orderTotal) AS maxTotal\nWHERE orderTotal = maxTotal\nRETURN c.companyName AS customerName, maxTotal AS orderValue", "out_tokens": 84, "stop": "stop"}], "in_tokens": 1256, "api_error": null}
