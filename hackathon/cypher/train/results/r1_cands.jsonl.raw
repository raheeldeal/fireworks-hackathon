{"id": "tr430", "cands": [{"raw": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWITH p.productID AS productID, sum(r.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nRETURN productID, totalQuantity\nLIMIT 1<|eot|>", "text": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWITH p.productID AS productID, sum(r.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nRETURN productID, totalQuantity\nLIMIT 1", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH p.productID AS productID, sum(rel.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nRETURN productID, totalQuantity\nLIMIT 1<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH p.productID AS productID, sum(rel.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nRETURN productID, totalQuantity\nLIMIT 1", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH p.productID AS productID, SUM(rel.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nRETURN productID, totalQuantity\nLIMIT 1<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH p.productID AS productID, SUM(rel.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nRETURN productID, totalQuantity\nLIMIT 1", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (p:Product)<-[o:ORDERS]-(:Order)\nWITH p.productID AS productID, sum(toInteger(o.quantity)) AS totalQuantity\nORDER BY totalQuantity DESC\nRETURN productID, totalQuantity\nLIMIT 1<|eot|>", "text": "MATCH (p:Product)<-[o:ORDERS]-(:Order)\nWITH p.productID AS productID, sum(toInteger(o.quantity)) AS totalQuantity\nORDER BY totalQuantity DESC\nRETURN productID, totalQuantity\nLIMIT 1", "out_tokens": 49, "stop": "stop"}], "in_tokens": 1260, "api_error": null}
