{"id": "tr342", "cands": [{"raw": "MATCH (u1:User)-[:POSTS]->(t1:Tweet)-[:MENTIONS]->(me:Me {screen_name: 'neo4j'})\nMATCH (u1)-[:POSTS]->(t1)-[:TAGS]->(hashtag:Hashtag)\nMATCH (u2:User)-[:FOLLOWS]->(u1)\nMATCH (u2)-[:POSTS]->(t2:Tweet)-[:TAGS]->(hashtag)\nMATCH (u2)-[:SIMILAR_TO]->(u3:User)\nWHERE u3.screen_name <> u2.screen_name AND u3.screen_name <> u1.screen_name AND\n      EXISTS {\n        MATCH (u3)-[:POSTS]->(t3:Tweet)-[:MENTIONS]->(me)\n      }\nWITH u1, u2, u3, max(sim.score) AS similarity_score\nWHERE similarity_score > 0.7\nWITH avg(u1.followers) AS average_followers\nRETURN average_followers<|eot|>", "text": "MATCH (u1:User)-[:POSTS]->(t1:Tweet)-[:MENTIONS]->(me:Me {screen_name: 'neo4j'})\nMATCH (u1)-[:POSTS]->(t1)-[:TAGS]->(hashtag:Hashtag)\nMATCH (u2:User)-[:FOLLOWS]->(u1)\nMATCH (u2)-[:POSTS]->(t2:Tweet)-[:TAGS]->(hashtag)\nMATCH (u2)-[:SIMILAR_TO]->(u3:User)\nWHERE u3.screen_name <> u2.screen_name AND u3.screen_name <> u1.screen_name AND\n      EXISTS {\n        MATCH (u3)-[:POSTS]->(t3:Tweet)-[:MENTIONS]->(me)\n      }\nWITH u1, u2, u3, max(sim.score) AS similarity_score\nWHERE similarity_score > 0.7\nWITH avg(u1.followers) AS average_followers\nRETURN average_followers", "out_tokens": 208, "stop": "stop"}, {"raw": "MATCH (u:User)-[:POSTS]->(t:Tweet)-[:MENTIONS]->(m:User {screen_name: 'neo4j'})\nMATCH (u)-[:POSTS]->(t2:Tweet)-[:TAGS]->(h:Hashtag)\nMATCH (u2:User)-[:FOLLOWS]->(u)\nMATCH (u2)-[:POSTS]->(t3:Tweet)-[:TAGS]->(h)\nMATCH (u2)-[:SIMILAR_TO]->(u3:User)\nWHERE u3.betweenness > 0.7\nMATCH (u3)-[:POSTS]->(t4:Tweet)-[:MENTIONS]->(m)\nWITH avg(u.followers) AS average_followers\nRETURN average_followers<|eot|>", "text": "MATCH (u:User)-[:POSTS]->(t:Tweet)-[:MENTIONS]->(m:User {screen_name: 'neo4j'})\nMATCH (u)-[:POSTS]->(t2:Tweet)-[:TAGS]->(h:Hashtag)\nMATCH (u2:User)-[:FOLLOWS]->(u)\nMATCH (u2)-[:POSTS]->(t3:Tweet)-[:TAGS]->(h)\nMATCH (u2)-[:SIMILAR_TO]->(u3:User)\nWHERE u3.betweenness > 0.7\nMATCH (u3)-[:POSTS]->(t4:Tweet)-[:MENTIONS]->(m)\nWITH avg(u.followers) AS average_followers\nRETURN average_followers", "out_tokens": 160, "stop": "stop"}, {"raw": "MATCH (u:User)-[:POSTS]->(t1:Tweet)-[:MENTIONS]->(m:User {screen_name: 'Neo4j'})\nMATCH (u)-[:FOLLOWS]-(f:User)-[:SIMILAR_TO]-(s:User {screen_name: 'Neo4j'})\nWHERE EXISTS {\n  MATCH (f)-[:POSTS]->(t2:Tweet)-[:TAGS]->(h:Hashtag)\n  WHERE h.name = 'Neo4j' AND (u)-[:POSTS]->(:Tweet)-[:TAGS]->(h)\n}\nWITH DISTINCT u\nRETURN avg(u.followers) AS average_followers<|eot|>", "text": "MATCH (u:User)-[:POSTS]->(t1:Tweet)-[:MENTIONS]->(m:User {screen_name: 'Neo4j'})\nMATCH (u)-[:FOLLOWS]-(f:User)-[:SIMILAR_TO]-(s:User {screen_name: 'Neo4j'})\nWHERE EXISTS {\n  MATCH (f)-[:POSTS]->(t2:Tweet)-[:TAGS]->(h:Hashtag)\n  WHERE h.name = 'Neo4j' AND (u)-[:POSTS]->(:Tweet)-[:TAGS]->(h)\n}\nWITH DISTINCT u\nRETURN avg(u.followers) AS average_followers", "out_tokens": 138, "stop": "stop"}, {"raw": "MATCH (u:User)-[:POSTS]->(t:Tweet)-[:MENTIONS]->(m:Me {screen_name: 'neo4j'})\nWITH u\nMATCH (u)-[:POSTS]->(t2:Tweet)-[:TAGS]->(h:Hashtag)\nMATCH (f:User)-[:FOLLOWS]->(u)\nMATCH (f)-[:POSTS]->(t3:Tweet)-[:TAGS]->(h)\nMATCH (f)-[:SIMILAR_TO]->(s:User)\nWHERE s.betweenness > 0.7\nMATCH (s)-[:POSTS]->(t4:Tweet)-[:MENTIONS]->(m)\nWITH DISTINCT u\nRETURN avg(u.followers) AS average_followers<|eot|>", "text": "MATCH (u:User)-[:POSTS]->(t:Tweet)-[:MENTIONS]->(m:Me {screen_name: 'neo4j'})\nWITH u\nMATCH (u)-[:POSTS]->(t2:Tweet)-[:TAGS]->(h:Hashtag)\nMATCH (f:User)-[:FOLLOWS]->(u)\nMATCH (f)-[:POSTS]->(t3:Tweet)-[:TAGS]->(h)\nMATCH (f)-[:SIMILAR_TO]->(s:User)\nWHERE s.betweenness > 0.7\nMATCH (s)-[:POSTS]->(t4:Tweet)-[:MENTIONS]->(m)\nWITH DISTINCT u\nRETURN avg(u.followers) AS average_followers", "out_tokens": 156, "stop": "stop"}], "in_tokens": 882, "api_error": null}
