{"id": "tr358", "cands": [{"raw": "MATCH (me:Me {screen_name: 'neo4j'})<-[s:SIMILAR_TO]-(u:User)\nRETURN u.screen_name AS user, s.score AS similarity_score\nORDER BY s.score DESC\nLIMIT 5<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})<-[s:SIMILAR_TO]-(u:User)\nRETURN u.screen_name AS user, s.score AS similarity_score\nORDER BY s.score DESC\nLIMIT 5", "out_tokens": 50, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'neo4j'})-[s:SIMILAR_TO]->(similarUser)\nRETURN similarUser.screen_name AS user, s.score AS similarity\nORDER BY s.score DESC\nLIMIT 5<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})-[s:SIMILAR_TO]->(similarUser)\nRETURN similarUser.screen_name AS user, s.score AS similarity\nORDER BY s.score DESC\nLIMIT 5", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})<-[:SIMILAR_TO]-(user:User)\nRETURN user.screen_name AS user, SIMILAR_TO.score AS score\nORDER BY score DESC\nLIMIT 5<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})<-[:SIMILAR_TO]-(user:User)\nRETURN user.screen_name AS user, SIMILAR_TO.score AS score\nORDER BY score DESC\nLIMIT 5", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})<-[:SIMILAR_TO]-(user:User)\nRETURN user.screen_name AS user, user.betweenness AS betweenness, user.followers AS followers\nORDER BY user.betweenness DESC\nLIMIT 5<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})<-[:SIMILAR_TO]-(user:User)\nRETURN user.screen_name AS user, user.betweenness AS betweenness, user.followers AS followers\nORDER BY user.betweenness DESC\nLIMIT 5", "out_tokens": 58, "stop": "stop"}], "in_tokens": 846, "api_error": null}
{"id": "tr359", "cands": [{"raw": "MATCH (p:Person {name: 'Lana Wachowski'})\nMATCH (p)-[r]->(m)\nRETURN type(r) AS relationshipType, m.title AS movieTitle<|eot|>", "text": "MATCH (p:Person {name: 'Lana Wachowski'})\nMATCH (p)-[r]->(m)\nRETURN type(r) AS relationshipType, m.title AS movieTitle", "out_tokens": 37, "stop": "stop"}, {"raw": "MATCH (p:Person {name: 'Lana Wachowski'})-[r]->(m)\nRETURN type(r) AS relationship_type, m.title AS movie_title<|eot|>", "text": "MATCH (p:Person {name: 'Lana Wachowski'})-[r]->(m)\nRETURN type(r) AS relationship_type, m.title AS movie_title", "out_tokens": 33, "stop": "stop"}, {"raw": "MATCH (p:Person {name: 'Lana Wachowski'})-[r]->(target)\nRETURN type(r) AS relationship_type, target, properties(r) AS relationship_properties<|eot|>", "text": "MATCH (p:Person {name: 'Lana Wachowski'})-[r]->(target)\nRETURN type(r) AS relationship_type, target, properties(r) AS relationship_properties", "out_tokens": 36, "stop": "stop"}, {"raw": "MATCH (p:Person {name: \"Lana Wachowski\"})\nRETURN p, relationships(p)<|eot|>", "text": "MATCH (p:Person {name: \"Lana Wachowski\"})\nRETURN p, relationships(p)", "out_tokens": 20, "stop": "stop"}], "in_tokens": 372, "api_error": null}
{"id": "tr360", "cands": [{"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:POSTS]->(neo4j_tweet:Tweet)\nMATCH (neo4j_tweet)<-[:RETWEETS]-(retweeter:Tweet)\nMATCH (retweeter)-[:MENTIONS]->(mentioned_user:User)\nMATCH (mentioned_user)<-[:REPLY_TO]-(reply_tweet:Tweet)\nMATCH (reply_tweet)-[:MENTIONS]->(mentioned_user2:User)\nMATCH (mentioned_user2)<-[:RETWEETS]-(retweeter2:Tweet)\nMATCH (retweeter2)<-[:POSTS]-(user:User)\nWITH avg(user.betweenness) AS average_betweenness\nRETURN average_betweenness<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:POSTS]->(neo4j_tweet:Tweet)\nMATCH (neo4j_tweet)<-[:RETWEETS]-(retweeter:Tweet)\nMATCH (retweeter)-[:MENTIONS]->(mentioned_user:User)\nMATCH (mentioned_user)<-[:REPLY_TO]-(reply_tweet:Tweet)\nMATCH (reply_tweet)-[:MENTIONS]->(mentioned_user2:User)\nMATCH (mentioned_user2)<-[:RETWEETS]-(retweeter2:Tweet)\nMATCH (retweeter2)<-[:POSTS]-(user:User)\nWITH avg(user.betweenness) AS average_betweenness\nRETURN average_betweenness", "out_tokens": 159, "stop": "stop"}, {"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})\nMATCH (neo4j)-[:POSTS]->(tweet: Tweet)<-[:RETWEETS]-(retweetedBy: User)\nMATCH (retweetedBy)-[:POSTS]->(retweetedByTweet: Tweet)-[:MENTIONS]->(mentionedUser: User)\nMATCH (mentionedUser)-[:POSTS]->(repliedTweet: Tweet)-[:REPLY_TO]->(tweetToReplyTo: Tweet)\nMATCH (tweetToReplyTo)-[:MENTIONS]->(userWhoRetweeted: User)\nWITH DISTINCT userWhoRetweeted.betweenness AS betweenness\nRETURN avg(betweenness) AS average_betweenness<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})\nMATCH (neo4j)-[:POSTS]->(tweet: Tweet)<-[:RETWEETS]-(retweetedBy: User)\nMATCH (retweetedBy)-[:POSTS]->(retweetedByTweet: Tweet)-[:MENTIONS]->(mentionedUser: User)\nMATCH (mentionedUser)-[:POSTS]->(repliedTweet: Tweet)-[:REPLY_TO]->(tweetToReplyTo: Tweet)\nMATCH (tweetToReplyTo)-[:MENTIONS]->(userWhoRetweeted: User)\nWITH DISTINCT userWhoRetweeted.betweenness AS betweenness\nRETURN avg(betweenness) AS average_betweenness", "out_tokens": 150, "stop": "stop"}, {"raw": "MATCH (me:Me {name: 'Neo4j'})-[:POSTS]->(neo4jTweet:Tweet)<-[:RETWEETS]-(retweet1:Tweet)\nWITH retweet1\nMATCH (retweet1)-[:MENTIONS]->(mentionedUser1:User)\nWITH DISTINCT mentionedUser1\nMATCH (mentionedUser1)<-[:REPLY_TO]-(replyTweet:Tweet)\nWITH DISTINCT replyTweet\nMATCH (replyTweet)-[:MENTIONS]->(mentionedUser2:User)\nWITH DISTINCT mentionedUser2\nMATCH (mentionedUser2)<-[:RETWEETS]-(retweet2:Tweet)\nWITH DISTINCT retweet2\nMATCH (retweet2)<-[:POSTS]-(user:User)\nWITH avg(user.betweenness) AS averageBetweenness\nRETURN averageBetweenness<|eot|>", "text": "MATCH (me:Me {name: 'Neo4j'})-[:POSTS]->(neo4jTweet:Tweet)<-[:RETWEETS]-(retweet1:Tweet)\nWITH retweet1\nMATCH (retweet1)-[:MENTIONS]->(mentionedUser1:User)\nWITH DISTINCT mentionedUser1\nMATCH (mentionedUser1)<-[:REPLY_TO]-(replyTweet:Tweet)\nWITH DISTINCT replyTweet\nMATCH (replyTweet)-[:MENTIONS]->(mentionedUser2:User)\nWITH DISTINCT mentionedUser2\nMATCH (mentionedUser2)<-[:RETWEETS]-(retweet2:Tweet)\nWITH DISTINCT retweet2\nMATCH (retweet2)<-[:POSTS]-(user:User)\nWITH avg(user.betweenness) AS averageBetweenness\nRETURN averageBetweenness", "out_tokens": 173, "stop": "stop"}, {"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:POSTS]->(neo4j_tweet:Tweet)<-[:RETWEETS]-(retweeter1:Tweet)<-[:REPLY_TO]-(reply_tweet:Tweet)-[:MENTIONS]->(user1:User)\nWITH DISTINCT user1\nMATCH (user1)<-[:MENTIONS]-(tweet2:Tweet)<-[:RETWEETS]-(user2:Tweet)<-[:RETWEETS]-(retweeter2:User)\nWITH DISTINCT retweeter2\nRETURN avg(retweeter2.betweenness)<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:POSTS]->(neo4j_tweet:Tweet)<-[:RETWEETS]-(retweeter1:Tweet)<-[:REPLY_TO]-(reply_tweet:Tweet)-[:MENTIONS]->(user1:User)\nWITH DISTINCT user1\nMATCH (user1)<-[:MENTIONS]-(tweet2:Tweet)<-[:RETWEETS]-(user2:Tweet)<-[:RETWEETS]-(retweeter2:User)\nWITH DISTINCT retweeter2\nRETURN avg(retweeter2.betweenness)", "out_tokens": 131, "stop": "stop"}], "in_tokens": 858, "api_error": null}
{"id": "tr361", "cands": [{"raw": "MATCH (o:Order)-[orders:ORDERS]->(p:Product)-[:PART_OF]->(c:Category)\nRETURN c.categoryName AS Category, sum(orders.quantity) AS TotalQuantity<|eot|>", "text": "MATCH (o:Order)-[orders:ORDERS]->(p:Product)-[:PART_OF]->(c:Category)\nRETURN c.categoryName AS Category, sum(orders.quantity) AS TotalQuantity", "out_tokens": 41, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nMATCH (o:Order)-[rel:ORDERS]->(p)\nWITH c.categoryName AS category, sum(rel.quantity) AS totalQuantity\nRETURN category, totalQuantity<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nMATCH (o:Order)-[rel:ORDERS]->(p)\nWITH c.categoryName AS category, sum(rel.quantity) AS totalQuantity\nRETURN category, totalQuantity", "out_tokens": 50, "stop": "stop"}, {"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)-[:PART_OF]->(c:Category)\nWITH c.categoryName AS category, SUM(toInteger(rel.quantity)) AS totalQuantity\nRETURN category, totalQuantity<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)-[:PART_OF]->(c:Category)\nWITH c.categoryName AS category, SUM(toInteger(rel.quantity)) AS totalQuantity\nRETURN category, totalQuantity", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (o:Order)-[r:ORDERS]->(p:Product)-[:PART_OF]->(c:Category)\nRETURN c.categoryName AS Category, sum(r.quantity) AS TotalQuantity<|eot|>", "text": "MATCH (o:Order)-[r:ORDERS]->(p:Product)-[:PART_OF]->(c:Category)\nRETURN c.categoryName AS Category, sum(r.quantity) AS TotalQuantity", "out_tokens": 40, "stop": "stop"}], "in_tokens": 1257, "api_error": null}
