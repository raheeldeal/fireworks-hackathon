{"id": "tr102", "cands": [{"raw": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)-[:COUNTRY]->(c:Country)\nWITH c, e\nMATCH (f2:Filing)-[:BENEFITS]->(e)-[:COUNTRY]->(c)\nWITH c, count(DISTINCT e) AS entityCount\nRETURN c.name AS country, entityCount\nORDER BY entityCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)-[:COUNTRY]->(c:Country)\nWITH c, e\nMATCH (f2:Filing)-[:BENEFITS]->(e)-[:COUNTRY]->(c)\nWITH c, count(DISTINCT e) AS entityCount\nRETURN c.name AS country, entityCount\nORDER BY entityCount DESC\nLIMIT 3", "out_tokens": 83, "stop": "stop"}, {"raw": "MATCH (e:Entity)-[:COUNTRY]->(c:Country)\nMATCH (e)-[:ORIGINATOR]->(:Filing)\nMATCH (e)-[:BENEFITS]->(:Filing)\nWITH c, count(DISTINCT e) AS entityCount\nORDER BY entityCount DESC\nLIMIT 3\nRETURN c.name AS country, entityCount<|eot|>", "text": "MATCH (e:Entity)-[:COUNTRY]->(c:Country)\nMATCH (e)-[:ORIGINATOR]->(:Filing)\nMATCH (e)-[:BENEFITS]->(:Filing)\nWITH c, count(DISTINCT e) AS entityCount\nORDER BY entityCount DESC\nLIMIT 3\nRETURN c.name AS country, entityCount", "out_tokens": 72, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)-[:COUNTRY]->(c:Country)\nMATCH (f)-[:BENEFITS]->(e)\nWITH c, count(DISTINCT e) AS count\nORDER BY count DESC\nLIMIT 3\nRETURN c.name, count<|eot|>", "text": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)-[:COUNTRY]->(c:Country)\nMATCH (f)-[:BENEFITS]->(e)\nWITH c, count(DISTINCT e) AS count\nORDER BY count DESC\nLIMIT 3\nRETURN c.name, count", "out_tokens": 63, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:ORIGINATOR]->(o:Entity)-[:COUNTRY]->(originCountry:Country)\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(beneficiaryCountry:Country)\nWHERE o = b\nWITH beneficiaryCountry, COUNT(DISTINCT o) AS entityCount\nRETURN beneficiaryCountry.name AS country, entityCount\nORDER BY entityCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (f:Filing)-[:ORIGINATOR]->(o:Entity)-[:COUNTRY]->(originCountry:Country)\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(beneficiaryCountry:Country)\nWHERE o = b\nWITH beneficiaryCountry, COUNT(DISTINCT o) AS entityCount\nRETURN beneficiaryCountry.name AS country, entityCount\nORDER BY entityCount DESC\nLIMIT 3", "out_tokens": 89, "stop": "stop"}], "in_tokens": 729, "api_error": null}
