{"id": "tr363", "cands": [{"raw": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'United Kingdom'\nWITH max(f.amount) AS max_amount\nMATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)\nWHERE f.amount = max_amount AND f.beneficiary_bank_country = 'United Kingdom'\nRETURN e.name<|eot|>", "text": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'United Kingdom'\nWITH max(f.amount) AS max_amount\nMATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)\nWHERE f.amount = max_amount AND f.beneficiary_bank_country = 'United Kingdom'\nRETURN e.name", "out_tokens": 74, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'United Kingdom'\nWITH f\nORDER BY f.amount DESC\nLIMIT 1\nMATCH (f)-[:ORIGINATOR]->(o:Entity)\nRETURN o.name AS originator<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'United Kingdom'\nWITH f\nORDER BY f.amount DESC\nLIMIT 1\nMATCH (f)-[:ORIGINATOR]->(o:Entity)\nRETURN o.name AS originator", "out_tokens": 61, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.beneficiary_bank_country = 'United Kingdom'\nWITH f\nORDER BY f.amount DESC\nLIMIT 1\nMATCH (e:Entity)-[:ORIGINATOR]->(f)\nRETURN e.name<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.beneficiary_bank_country = 'United Kingdom'\nWITH f\nORDER BY f.amount DESC\nLIMIT 1\nMATCH (e:Entity)-[:ORIGINATOR]->(f)\nRETURN e.name", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.beneficiary_bank_country = 'United Kingdom'\nWITH max(f.amount) AS max_amount\nMATCH (f:Filing)\nWHERE f.amount = max_amount\nMATCH (f)-[:ORIGINATOR]->(e:Entity)\nRETURN e.name AS entity_name<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.beneficiary_bank_country = 'United Kingdom'\nWITH max(f.amount) AS max_amount\nMATCH (f:Filing)\nWHERE f.amount = max_amount\nMATCH (f)-[:ORIGINATOR]->(e:Entity)\nRETURN e.name AS entity_name", "out_tokens": 60, "stop": "stop"}], "in_tokens": 730,