{"id": "tr063", "cands": [{"raw": "MATCH (e:Entity)-[:COUNTRY]->(c:Country)\nMATCH (e)-[:FILED]->(f:Filing)\nWITH c, count(DISTINCT e) AS entityCount\nORDER BY entityCount DESC\nLIMIT 3\nRETURN c.name<|eot|>", "text": "MATCH (e:Entity)-[:COUNTRY]->(c:Country)\nMATCH (e)-[:FILED]->(f:Filing)\nWITH c, count(DISTINCT e) AS entityCount\nORDER BY entityCount DESC\nLIMIT 3\nRETURN c.name", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (e:Entity)-[:FILED]->(:Filing)\nWITH e.country AS country_code, count(e) AS entity_count\nORDER BY entity_count DESC\nLIMIT 3\nMATCH (c:Country {code: country_code})\nRETURN c.name AS country_name, entity_count<|eot|>", "text": "MATCH (e:Entity)-[:FILED]->(:Filing)\nWITH e.country AS country_code, count(e) AS entity_count\nORDER BY entity_count DESC\nLIMIT 3\nMATCH (c:Country {code: country_code})\nRETURN c.name AS country_name, entity_count", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (e:Entity)-[:FILED]->(f:Filing)-[:BENEFITS|:CONCERNS|:ORIGINATOR]->(e2:Entity)-[:COUNTRY]->(c:Country)\nWITH c, count(DISTINCT e2) AS entityCount\nORDER BY entityCount DESC\nLIMIT 3\nRETURN c.name, entityCount<|eot|>", "text": "MATCH (e:Entity)-[:FILED]->(f:Filing)-[:BENEFITS|:CONCERNS|:ORIGINATOR]->(e2:Entity)-[:COUNTRY]->(c:Country)\nWITH c, count(DISTINCT e2) AS entityCount\nORDER BY entityCount DESC\nLIMIT 3\nRETURN c.name, entityCount", "out_tokens": 73, "stop": "stop"}, {"raw": "MATCH (c:Country)<-[:COUNTRY]-(e:Entity)-[:FILED]->(f:Filing)\nWITH c, count(e) AS entity_count\nORDER BY entity_count DESC\nLIMIT 3\nRETURN c.name AS country, entity_count<|eot|>", "text": "MATCH (c:Country)<-[:COUNTRY]-(e:Entity)-[:FILED]->(f:Filing)\nWITH c, count(e) AS entity_count\nORDER BY entity_count DESC\nLIMIT 3\nRETURN c.name AS country, entity_count", "out_tokens": 53, "stop": "stop"}], "in_tokens": 725, "api_error": null}
