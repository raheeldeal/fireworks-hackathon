{"id": "tr068", "cands": [{"raw": "MATCH (f:Filing)\nWHERE f.origin_lat IS NOT NULL AND f.beneficiary_lat IS NOT NULL\nWITH f, abs(toFloat(f.origin_lat) - toFloat(f.beneficiary_lat)) AS latDiff\nORDER BY latDiff DESC\nLIMIT 3\nRETURN f.sar_id AS filing_id, latDiff<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.origin_lat IS NOT NULL AND f.beneficiary_lat IS NOT NULL\nWITH f, abs(toFloat(f.origin_lat) - toFloat(f.beneficiary_lat)) AS latDiff\nORDER BY latDiff DESC\nLIMIT 3\nRETURN f.sar_id AS filing_id, latDiff", "out_tokens": 67, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.origin_lat IS NOT NULL AND f.beneficiary_lat IS NOT NULL\nWITH f, abs(toFloat(f.origin_lat) - toFloat(f.beneficiary_lat)) AS latitudeDifference\nORDER BY latitudeDifference DESC\nLIMIT 3\nRETURN f.sar_id AS FilingID, latitudeDifference<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.origin_lat IS NOT NULL AND f.beneficiary_lat IS NOT NULL\nWITH f, abs(toFloat(f.origin_lat) - toFloat(f.beneficiary_lat)) AS latitudeDifference\nORDER BY latitudeDifference DESC\nLIMIT 3\nRETURN f.sar_id AS FilingID, latitudeDifference", "out_tokens": 67, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.origin_lat IS NOT NULL AND f.beneficiary_lat IS NOT NULL\nWITH f, toFloat(f.origin_lat) - toFloat(f.beneficiary_lat) AS lat_diff\nORDER BY abs(lat_diff) DESC\nLIMIT 3\nRETURN f.id AS filing_id, lat_diff<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.origin_lat IS NOT NULL AND f.beneficiary_lat IS NOT NULL\nWITH f, toFloat(f.origin_lat) - toFloat(f.beneficiary_lat) AS lat_diff\nORDER BY abs(lat_diff) DESC\nLIMIT 3\nRETURN f.id AS filing_id, lat_diff", "out_tokens": 66, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.origin_lat IS NOT NULL AND f.beneficiary_lat IS NOT NULL\nWITH f, abs(toFloat(f.origin_lat) - toFloat(f.beneficiary_lat)) AS lat_diff\nORDER BY lat_diff DESC\nLIMIT 3\nRETURN f.sar_id AS filing_id, lat_diff<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.origin_lat IS NOT NULL AND f.beneficiary_lat IS NOT NU