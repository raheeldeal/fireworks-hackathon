{"id": "tr261", "cands": [{"raw": "MATCH (f:Filing)\nWHERE f.originator_iso <> f.beneficiary_iso\nWITH f.originator_iso AS origin_country, count(f) AS filings_count\nORDER BY filings_count DESC\nLIMIT 5\nRETURN origin_country, filings_count<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.originator_iso <> f.beneficiary_iso\nWITH f.originator_iso AS origin_country, count(f) AS filings_count\nORDER BY filings_count DESC\nLIMIT 5\nRETURN origin_country, filings_count", "out_tokens": 50, "stop": "stop"}, {"raw": "MATCH (c:Country)<-[:COUNTRY]-(e:Entity)<-[:ORIGINATOR]-(f:Filing)-[:BENEFITS]->(be:Entity)-[:COUNTRY]->(bc:Country)\nWHERE c <> bc\nWITH c, count(f) AS filingCount\nORDER BY filingCount DESC\nLIMIT 5\nRETURN c.name AS country, filingCount<|eot|>", "text": "MATCH (c:Country)<-[:COUNTRY]-(e:Entity)<-[:ORIGINATOR]-(f:Filing)-[:BENEFITS]->(be:Entity)-[:COUNTRY]->(bc:Country)\nWHERE c <> bc\nWITH c, count(f) AS filingCount\nORDER BY filingCount DESC\nLIMIT 5\nRETURN c.name AS country, filingCount", "out_tokens": 79, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.originator_bank_country <> f.beneficiary_bank_country\nWITH f.originator_bank_country AS originator_country, f.beneficiary_bank_country AS beneficiary_country\nUNWIND [originator_country, beneficiary_country] AS country_name\nWITH country_name, count(*) AS num_filings\nORDER BY num_filings DESC\nLIMIT 5\nRETURN country_name AS country, num_filings<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.originator_bank_country <> f.beneficiary_bank_country\nWITH f.originator_bank_country AS originator_country, f.beneficiary_bank_country AS beneficiary_country\nUNWIND [originator_country, beneficiary_country] AS country_name\nWITH country_name, count(*) AS num_filings\nORDER BY num_filings DESC\nLIMIT 5\nRETURN country_name AS country, num_filings", "out_tokens": 90, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.originator_bank_country <> f.beneficiary_bank_country\nWITH f.originator_bank_country AS originatorCountry, f.beneficiary_bank_country AS beneficiaryCountry\nUNWIND [originatorCountry, beneficiaryCountry] AS country\nWITH country, count(*) AS filingCount\nORDER BY filingCount DESC\nLIMIT 5\nRETURN country AS Country, filingCount AS NumberOfFilings<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.originator_bank_country <> f.beneficiary_bank_country\nWITH f.originator_bank_country AS originatorCountry, f.beneficiary_bank_country AS beneficiaryCountry\nUNWIND [originatorCountry, beneficiaryCountry] AS country\nWITH country, count(*) AS filingCount\nORDER BY filingCount DESC\nLIMIT 5\nRETURN country AS Country, filingCount AS NumberOfFilings", "out_tokens": 86, "stop": "stop"}], "in_tokens": 725, "api_error": null}
