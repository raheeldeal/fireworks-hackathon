{"id": "tr408", "cands": [{"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)<-[:ORDERS]-(o:Order)\nWITH s, COLLECT(DISTINCT o.shipRegion) AS regions\nWHERE SIZE(regions) > 1\nRETURN s.companyName AS supplierName, regions<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)<-[:ORDERS]-(o:Order)\nWITH s, COLLECT(DISTINCT o.shipRegion) AS regions\nWHERE SIZE(regions) > 1\nRETURN s.companyName AS supplierName, regions", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)<-[:ORDERS]-(o:Order)\nWITH s, collect(distinct o.shipRegion) AS regions\nWHERE size(regions) > 1\nRETURN s.companyName, regions<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)<-[:ORDERS]-(o:Order)\nWITH s, collect(distinct o.shipRegion) AS regions\nWHERE size(regions) > 1\nRETURN s.companyName, regions", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)<-[:ORDERS]-(o:Order)\nWITH s, collect(DISTINCT o.shipRegion) AS regions\nWHERE size(regions) > 1\nRETURN s.companyName AS SupplierName, regions<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)<-[:ORDERS]-(o:Order)\nWITH s, collect(DISTINCT o.shipRegion) AS regions\nWHERE size(regions) > 1\nRETURN s.companyName AS SupplierName, regions", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)<-[:PART_OF]-(c:Category)\nWITH s, COLLECT(DISTINCT c.categoryName) AS regions\nWHERE SIZE(regions) > 1\nRETURN s.companyName, regions<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)<-[:PART_OF]-(c:Category)\nWITH s, COLLECT(DISTINCT c.categoryName) AS regions\nWHERE SIZE(regions) > 1\nRETURN s.companyName, regions", "out_tokens": 56, "stop": "stop"}], "in_tokens": 1254, "api_error": null}
