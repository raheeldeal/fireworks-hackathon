{"id": "tr318", "cands": [{"raw": "MATCH (f:Filing)-[:ORIGINATOR]->(o:Entity)-[:COUNTRY]->(c1:Country)\nWHERE c1.code = \"SGP\"\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(c2:Country)\nWHERE c2.code = \"GBR\"\nRETURN f\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)-[:ORIGINATOR]->(o:Entity)-[:COUNTRY]->(c1:Country)\nWHERE c1.code = \"SGP\"\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(c2:Country)\nWHERE c2.code = \"GBR\"\nRETURN f\nLIMIT 5", "out_tokens": 74, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nMATCH (oc:Country {code: \"SGP\"})\nMATCH (bc:Country {code: \"GBR\"})\nWHERE f.originator_iso = oc.code AND f.beneficiary_iso = bc.code\nRETURN f\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)\nMATCH (oc:Country {code: \"SGP\"})\nMATCH (bc:Country {code: \"GBR\"})\nWHERE f.originator_iso = oc.code AND f.beneficiary_iso = bc.code\nRETURN f\nLIMIT 5", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)-[:COUNTRY]->(o:Country)\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(benCountry:Country)\nWHERE o.code = \"SGP\" AND benCountry.code = \"GBR\"\nRETURN f\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)-[:ORIGINATOR]->(e:Entity)-[:COUNTRY]->(o:Country)\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(benCountry:Country)\nWHERE o.code = \"SGP\" AND benCountry.code = \"GBR\"\nRETURN f\nLIMIT 5", "out_tokens": 72, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nMATCH (o:Entity {id: f.originator_bank_id})-[:COUNTRY]->(oc:Country {code: \"SGP\"})\nMATCH (b:Entity {id: f.beneficiary_bank_id})-[:COUNTRY]->(bc:Country {code: \"GBR\"})\nRETURN f\nORDER BY f.begin\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)\nMATCH (o:Entity {id: f.originator_bank_id})-[:COUNTRY]->(oc:Country {code: \"SGP\"})\nMATCH (b:Entity {id: f.beneficiary_bank_id})-[:COUNTRY]->(bc:Country {code: \"GBR\"})\nRETURN f\nORDER BY f.begin\nLIMIT 5", "out_tokens": 78, "stop": "stop"}], "in_tokens": 744, "api_error": null}
