{"id": "tr239", "cands": [{"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:SIMILAR_TO]-(u:User)\nRETURN u, me.betweenness AS me_betweenness, u.betweenness AS user_betweenness, me.following AS me_following, u.following AS user_following\nORDER BY (u.betweenness - me.betweenness) + (u.following - me.following) ASC\nLIMIT 5<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:SIMILAR_TO]-(u:User)\nRETURN u, me.betweenness AS me_betweenness, u.betweenness AS user_betweenness, me.following AS me_following, u.following AS user_following\nORDER BY (u.betweenness - me.betweenness) + (u.following - me.following) ASC\nLIMIT 5", "out_tokens": 91, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:SIMILAR_TO]-(u:User)\nRETURN u, me.betweenness, me.following, u.betweenness, u.following\nORDER BY abs(me.betweenness - u.betweenness) + abs(me.following - u.following) ASC\nLIMIT 5<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:SIMILAR_TO]-(u:User)\nRETURN u, me.betweenness, me.following, u.betweenness, u.following\nORDER BY abs(me.betweenness - u.betweenness) + abs(me.following - u.following) ASC\nLIMIT 5", "out_tokens": 75, "stop": "stop"}, {"raw": "MATCH (neo4j:Me {screen_name: 'neo4j'})-[:SIMILAR_TO]-(u:User)\nWHERE u.betweenness IS NOT NULL AND u.following IS NOT NULL\nRETURN u.screen_name, u.betweenness, u.following, neo4j.betweenness, neo4j.following\nORDER BY u.betweenness DESC, u.following DESC\nLIMIT 5<|eot|>", "text": "MATCH (neo4j:Me {screen_name: 'neo4j'})-[:SIMILAR_TO]-(u:User)\nWHERE u.betweenness IS NOT NULL AND u.following IS NOT NULL\nRETURN u.screen_name, u.betweenness, u.following, neo4j.betweenness, neo4j.following\nORDER BY u.betweenness DESC, u.following DESC\nLIMIT 5", "out_tokens": 87, "stop": "stop"}, {"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:SIMILAR_TO]-(similar:User)\nRETURN similar.screen_name, similar.betweenness, similar.following\nORDER BY similar.betweenness DESC, similar.following DESC\nLIMIT 5<|eot|>", "text": "