{"id": "tr234", "cands": [{"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWITH d, sum(m.revenue) AS total_revenue, sum(m.budget) AS total_budget\nWITH d, (total_revenue / total_budget) AS revenue_to_budget_ratio\nORDER BY revenue_to_budget_ratio DESC\nRETURN d.name AS director, revenue_to_budget_ratio\nLIMIT 1<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWITH d, sum(m.revenue) AS total_revenue, sum(m.budget) AS total_budget\nWITH d, (total_revenue / total_budget) AS revenue_to_budget_ratio\nORDER BY revenue_to_budget_ratio DESC\nRETURN d.name AS director, revenue_to_budget_ratio\nLIMIT 1", "out_tokens": 76, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE m.budget > 0 AND m.revenue IS NOT NULL\nWITH d, SUM(m.revenue) AS totalRevenue, SUM(m.budget) AS totalBudget\nWITH d, totalRevenue / totalBudget AS revenueBudgetRatio\nRETURN d.name AS directorName, revenueBudgetRatio\nORDER BY revenueBudgetRatio DESC\nLIMIT 1<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE m.budget > 0 AND m.revenue IS NOT NULL\nWITH d, SUM(m.revenue) AS totalRevenue, SUM(m.budget) AS totalBudget\nWITH d, totalRevenue / totalBudget AS revenueBudgetRatio\nRETURN d.name AS directorName, revenueBudgetRatio\nORDER BY revenueBudgetRatio DESC\nLIMIT 1", "out_tokens": 85, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE m.revenue IS NOT NULL AND m.budget > 0\nWITH d, \n     sum(m.revenue) AS totalRevenue, \n     sum(m.budget) AS totalBudget,\n     toFloat(sum(m.revenue)) / toFloat(sum(m.budget)) AS revenueToBudgetRatio\nORDER BY revenueToBudgetRatio DESC\nRETURN d.name AS directorName, revenueToBudgetRatio\nLIMIT 1<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE m.revenue IS NOT NULL AND m.budget > 0\nWITH d, \n     sum(m.revenue) AS totalRevenue, \n     sum(m.budget) AS totalBudget,\n     toFloat(sum(m.revenue)) / toFloat(sum(m.budget)) AS revenueToBudgetRatio\nORDER BY revenueToBudgetRatio DESC\nRETURN d.name AS directorName, revenueToBudgetRatio\nLIMIT 1", "out_tokens": 100, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE m.budget > 0 AND m.revenue IS NOT NULL\nWITH d, sum(m.revenue) AS totalRevenue, sum(m.budget) AS totalBudget\nWITH d, totalRevenue / totalBudget AS ratio\nORDER BY ratio DESC\nRETURN d.name AS director, ratio\nLIMIT 1<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE m.budget > 0 AND m.revenue IS NOT NULL\nWITH d, sum(m.revenue) AS totalRevenue, sum(m.budget) AS totalBudget\nWITH d, totalRevenue / totalBudget AS ratio\nORDER BY ratio DESC\nRETURN d.name AS director, ratio\nLIMIT 1", "out_tokens": 78, "stop": "stop"}], "in_tokens": 1089, "api_error": null}
