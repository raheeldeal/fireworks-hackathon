{"id": "tr031", "cands": [{"raw": "MATCH (p:Product)\nRETURN p.productName, p.unitsOnOrder\nORDER BY p.unitsOnOrder DESC\nLIMIT 3<|eot|>", "text": "MATCH (p:Product)\nRETURN p.productName, p.unitsOnOrder\nORDER BY p.unitsOnOrder DESC\nLIMIT 3", "out_tokens": 27, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWHERE p.unitsOnOrder IS NOT NULL\nRETURN p.productName, p.unitsOnOrder\nORDER BY p.unitsOnOrder DESC\nLIMIT 3<|eot|>", "text": "MATCH (p:Product)\nWHERE p.unitsOnOrder IS NOT NULL\nRETURN p.productName, p.unitsOnOrder\nORDER BY p.unitsOnOrder DESC\nLIMIT 3", "out_tokens": 36, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWHERE p.unitsOnOrder IS NOT NULL\nRETURN p.productName, p.unitsOnOrder\nORDER BY p.unitsOnOrder DESC\nLIMIT 3<|eot|>", "text": "MATCH (p:Product)\nWHERE p.unitsOnOrder IS NOT NULL\nRETURN p.productName, p.unitsOnOrder\nORDER BY p.unitsOnOrder DESC\nLIMIT 3", "out_tokens": 36, "stop": "stop"}, {"raw": "MATCH (p:Product)\nRETURN p.productName, p.unitsOnOrder\nORDER BY p.unitsOnOrder DESC\nLIMIT 3<|eot|>", "text": "MATCH (p:Product)\nRETURN p.productName, p.unitsOnOrder\nORDER BY p.unitsOnOrder DESC\nLIMIT 3", "out_tokens": 27, "stop": "stop"}], "in_tokens": 1261, "api_error": null}
