{"id": "tr136", "cands": [{"raw": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name = \"Academy Award for Best Original Screenplay\"\nWITH avg(m.imdbRating) AS averageRating\nRETURN averageRating<|eot|>", "text": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name = \"Academy Award for Best Original Screenplay\"\nWITH avg(m.imdbRating) AS averageRating\nRETURN averageRating", "out_tokens": 44, "stop": "stop"}, {"raw": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre {name: \"Academy Award for Best Original Screenplay\"})\nWITH avg(m.imdbRating) AS averageRating\nRETURN averageRating<|eot|>", "text": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre {name: \"Academy Award for Best Original Screenplay\"})\nWITH avg(m.imdbRating) AS averageRating\nRETURN averageRating", "out_tokens": 42, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[r:RATED]-(:User)\nWHERE m.title IN ['The Godfather', 'The Godfather Part II', 'The Silence of the Lambs', 'Saving Private Ryan', 'The Pianist', 'No Country for Old Men', 'Spotlight', 'The Shape of Water', 'Parasite', 'Everything Everywhere All at Once']\nRETURN avg(r.rating) AS average_rating<|eot|>", "text": "MATCH (m:Movie)<-[r:RATED]-(:User)\nWHERE m.title IN ['The Godfather', 'The Godfather Part II', 'The Silence of the Lambs', 'Saving Private Ryan', 'The Pianist', 'No Country for Old Men', 'Spotlight', 'The Shape of Water', 'Parasite', 'Everything Everywhere All at Once']\nRETURN avg(r.rating) AS average_rating", "out_tokens": 85, "stop": "stop"}, {"raw": "MATCH (m:Movie)-[:RATED]->(r:Rated)\nWHERE m.award = \"Academy Award for Best Original Screenplay\"\nWITH avg(r.rating) AS averageRating\nRETURN averageRating<|eot|>", "text": "MATCH (m:Movie)-[:RATED]->(r:Rated)\nWHERE m.award = \"Academy Award for Best Original Screenplay\"\nWITH avg(r.rating) AS averageRating\nRETURN averageRating", "out_tokens": 42, "stop": "stop"}], "in_tokens": 1097, "api_error": null}
{"id": "tr137", "cands": [{"raw": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE p.born > 1970\nWITH m, COUNT(DISTINCT r.roles) AS totalRoles\nORDER BY totalRoles DESC\nLIMIT 5\nRETURN m.title AS movie, totalRoles<|eot|>", "text": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE p.born > 1970\nWITH m, COUNT(DISTINCT r.roles) AS totalRoles\nORDER BY totalRoles DESC\nLIMIT 5\nRETURN m.title AS movie, totalRoles", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[ai:ACTED_IN]-(p:Person)\nWHERE p.born > 1970\nRETURN m.title AS MovieTitle, COUNT(ai) AS NumRoles\nORDER BY NumRoles DESC\nLIMIT 5<|eot|>", "text": "MATCH (m:Movie)<-[ai:ACTED_IN]-(p:Person)\nWHERE p.born > 1970\nRETURN m.title AS MovieTitle, COUNT(ai) AS NumRoles\nORDER BY NumRoles DESC\nLIMIT 5", "out_tokens": 50, "stop": "stop"}, {"raw": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE p.born > 1970\nWITH m, count(r) AS numRoles\nORDER BY numRoles DESC\nLIMIT 5\nRETURN m.title AS movie, numRoles<|eot|>", "text": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE p.born > 1970\nWITH m, count(r) AS numRoles\nORDER BY numRoles DESC\nLIMIT 5\nRETURN m.title AS movie, numRoles", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE p.born > 1970\nWITH m, size(r.roles) AS numRoles\nRETURN m.title AS movie, numRoles\nORDER BY numRoles DESC\nLIMIT 5<|eot|>", "text": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE p.born > 1970\nWITH m, size(r.roles) AS numRoles\nRETURN m.title AS movie, numRoles\nORDER BY numRoles DESC\nLIMIT 5", "out_tokens": 56, "stop": "stop"}], "in_tokens": 382, "api_error": null}
{"id": "tr138", "cands": [{"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie), (p)-[:PRODUCED]->(m)\nRETURN m.title AS Title, m.votes AS Votes\nORDER BY m.votes DESC\nLIMIT 5<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie), (p)-[:PRODUCED]->(m)\nRETURN m.title AS Title, m.votes AS Votes\nORDER BY m.votes DESC\nLIMIT 5", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:PRODUCED]->(m:Movie)<-[:DIRECTED]-(p)\nRETURN m.title AS MovieTitle, p.name AS PersonName\nORDER BY m.votes DESC\nLIMIT 5<|eot|>", "text": "MATCH (p:Person)-[:PRODUCED]->(m:Movie)<-[:DIRECTED]-(p)\nRETURN m.title AS MovieTitle, p.name AS PersonName\nORDER BY m.votes DESC\nLIMIT 5", "out_tokens": 47, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[:PRODUCED]-(p:Person)-[:DIRECTED]->(m)\nRETURN m.title AS movie, p.name AS person\nORDER BY m.votes DESC\nLIMIT 5<|eot|>", "text": "MATCH (m:Movie)<-[:PRODUCED]-(p:Person)-[:DIRECTED]->(m)\nRETURN m.title AS movie, p.name AS person\nORDER BY m.votes DESC\nLIMIT 5", "out_tokens": 45, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:PRODUCED]->(m:Movie), (p)-[:DIRECTED]->(m)\nRETURN m.title AS Movie, p.name AS ProducerDirector, COUNT(*) AS Count\nORDER BY Count DESC\nLIMIT 5<|eot|>", "text": "MATCH (p:Person)-[:PRODUCED]->(m:Movie), (p)-[:DIRECTED]->(m)\nRETURN m.title AS Movie, p.name AS ProducerDirector, COUNT(*) AS Count\nORDER BY Count DESC\nLIMIT 5", "out_tokens": 51, "stop": "stop"}], "in_tokens": 378, "api_error": null}
{"id": "tr139", "cands": [{"raw": "MATCH (u:User {screen_name: 'neo4j'})-[:FOLLOWS]->(followed:User)<-[:MENTIONS]-(tweet:Tweet)\nWITH avg(tweet.favorites) AS average_favorites\nRETURN average_favorites<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})-[:FOLLOWS]->(followed:User)<-[:MENTIONS]-(tweet:Tweet)\nWITH avg(tweet.favorites) AS average_favorites\nRETURN average_favorites", "out_tokens": 53, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'neo4j'})\nMATCH (u)-[:FOLLOWS]->(followed:User)\nMATCH (t:Tweet)-[:MENTIONS]->(followed)\nWITH avg(t.favorites) AS avg_favorites\nRETURN avg_favorites<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})\nMATCH (u)-[:FOLLOWS]->(followed:User)\nMATCH (t:Tweet)-[:MENTIONS]->(followed)\nWITH avg(t.favorites) AS avg_favorites\nRETURN avg_favorites", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:FOLLOWS]->(followed:User)\nWITH followed\nMATCH (tweet:Tweet)-[:MENTIONS]->(followed)\nWITH tweet\nRETURN avg(tweet.favorites) AS average_favorites<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:FOLLOWS]->(followed:User)\nWITH followed\nMATCH (tweet:Tweet)-[:MENTIONS]->(followed)\nWITH tweet\nRETURN avg(tweet.favorites) AS average_favorites", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:FOLLOWS]->(followed:User)<-[:MENTIONS]-(tweet:Tweet)\nWITH avg(tweet.favorites) AS avg_favorites\nRETURN avg_favorites<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:FOLLOWS]->(followed:User)<-[:MENTIONS]-(tweet:Tweet)\nWITH avg(tweet.favorites) AS avg_favorites\nRETURN avg_favorites", "out_tokens": 53, "stop": "stop"}], "in_tokens": 838, "api_error": null}
