{"id": "tr474", "cands": [{"raw": "MATCH (m:Movie)<-[:DIRECTED]-(director:Person)\nWITH m, director, director.born AS directorBorn\nMATCH (m)<-[:ACTED_IN]-(actor:Person)\nWITH m, director, directorBorn, MAX(actor.born) AS oldestActorBorn\nWHERE directorBorn < oldestActorBorn\nRETURN m.title AS movieTitle, (2024 - directorBorn) AS directorAge<|eot|>", "text": "MATCH (m:Movie)<-[:DIRECTED]-(director:Person)\nWITH m, director, director.born AS directorBorn\nMATCH (m)<-[:ACTED_IN]-(actor:Person)\nWITH m, director, directorBorn, MAX(actor.born) AS oldestActorBorn\nWHERE directorBorn < oldestActorBorn\nRETURN m.title AS movieTitle, (2024 - directorBorn) AS directorAge", "out_tokens": 86, "stop": "stop"}, {"raw": "MATCH (director:Person)-[:DIRECTED]->(movie:Movie)<-[:ACTED_IN]-(actor:Person)\nWITH movie, director, max(actor.born) AS oldestActorBirthYear\nWHERE director.born < oldestActorBirthYear\nRETURN movie.title AS movieTitle, director.born AS directorAge<|eot|>", "text": "MATCH (director:Person)-[:DIRECTED]->(movie:Movie)<-[:ACTED_IN]-(actor:Person)\nWITH movie, director, max(actor.born) AS oldestActorBirthYear\nWHERE director.born < oldestActorBirthYear\nRETURN movie.title AS movieTitle, director.born AS directorAge", "out_tokens": 65, "stop": "stop"}, {"raw": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)<-[:ACTED_IN]-(a:Person)\nWITH m, d, max(a.born) AS oldest_actor_born\nWHERE d.born < oldest_actor_born\nRETURN m.title AS movie_title, (oldest_actor_born - d.born) AS director_age<|eot|>", "text": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)<-[:ACTED_IN]-(a:Person)\nWITH m, d, max(a.born) AS oldest_actor_born\nWHERE d.born < oldest_actor_born\nRETURN m.title AS movie_title, (oldest_actor_born - d.born) AS director_age", "out_tokens": 73, "stop": "stop"}, {"raw": "MATCH (director:Person)-[:DIRECTED]->(movie:Movie)\nMATCH (actor:Person)-[:ACTED_IN]->(movie)\nWITH movie, director, max(actor.born) AS oldest_actor_born\nWHERE director.born < oldest_actor_born\nRETURN movie.title 