{"id": "tr134", "cands": [{"raw": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.originator_bank_country = 'China'\nRETURN e.name AS beneficiary_bank, COUNT(f) AS number_of_filings\nORDER BY number_of_filings DESC\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.originator_bank_country = 'China'\nRETURN e.name AS beneficiary_bank, COUNT(f) AS number_of_filings\nORDER BY number_of_filings DESC\nLIMIT 5", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (f:Filing {originator_bank_country: 'China'})-[:BENEFITS]->(e:Entity)\nRETURN e.name AS BeneficiaryBank, COUNT(f) AS NumberOfFilings\nORDER BY NumberOfFilings DESC\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing {originator_bank_country: 'China'})-[:BENEFITS]->(e:Entity)\nRETURN e.name AS BeneficiaryBank, COUNT(f) AS NumberOfFilings\nORDER BY NumberOfFilings DESC\nLIMIT 5", "out_tokens": 53, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.originator_iso = 'CHN'\nRETURN f.beneficiary_bank AS BeneficiaryBank, count(f) AS FilingsCount\nORDER BY FilingsCount DESC\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.originator_iso = 'CHN'\nRETURN f.beneficiary_bank AS BeneficiaryBank, count(f) AS FilingsCount\nORDER BY FilingsCount DESC\nLIMIT 5", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(b:Entity)\nWHERE f.originator_bank_country = 'China'\nWITH b.name AS beneficiary_bank, COUNT(f) AS num_filings\nORDER BY num_filings DESC\nLIMIT 5\nRETURN beneficiary_bank, num_filings<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(b:Entity)\nWHERE f.originator_bank_country = 'China'\nWITH b.name AS beneficiary_bank, COUNT(f) AS num_filings\nORDER BY num_filings DESC\nLIMIT 5\nRETURN beneficiary_bank, num_filings", "out_tokens": 62, "stop": "stop"}], "in_tokens": 729, "api_error": null}
