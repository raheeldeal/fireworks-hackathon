{"id": "tr065", "cands": [{"raw": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWHERE f.originator_bank_id = e.id AND f.beneficiary_bank_id = e.id\nWITH e, COUNT(f) AS filingCount\nORDER BY filingCount DESC\nLIMIT 5\nRETURN e.name AS entity, filingCount<|eot|>", "text": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWHERE f.originator_bank_id = e.id AND f.beneficiary_bank_id = e.id\nWITH e, COUNT(f) AS filingCount\nORDER BY filingCount DESC\nLIMIT 5\nRETURN e.name AS entity, filingCount", "out_tokens": 63, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:ORIGINATOR]->(o:Entity)-[:COUNTRY]->(oc:Country)\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(bc:Country)\nWHERE oc.code = bc.code\nWITH oc.code AS country_code, COUNT(DISTINCT f) AS filing_count\nORDER BY filing_count DESC\nLIMIT 5\nRETURN country_code, filing_count<|eot|>", "text": "MATCH (f:Filing)-[:ORIGINATOR]->(o:Entity)-[:COUNTRY]->(oc:Country)\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(bc:Country)\nWHERE oc.code = bc.code\nWITH oc.code AS country_code, COUNT(DISTINCT f) AS filing_count\nORDER BY filing_count DESC\nLIMIT 5\nRETURN country_code, filing_count", "out_tokens": 88, "stop": "stop"}, {"raw": "MATCH (filing:Filing)\nMATCH (filing)-[:ORIGINATOR]->(originator:Entity)-[:COUNTRY]->(originCountry:Country)\nMATCH (filing)-[:BENEFITS]->(beneficiary:Entity)-[:COUNTRY]->(beneficiaryCountry:Country)\nWHERE originCountry = beneficiaryCountry\nWITH originCountry, count(filing) AS filingsCount\nORDER BY filingsCount DESC\nLIMIT 5\nRETURN originCountry.name, filingsCount<|eot|>", "text": "MATCH (filing:Filing)\nMATCH (filing)-[:ORIGINATOR]->(originator:Entity)-[:COUNTRY]->(originCountry:Country)\nMATCH (filing)-[:BENEFITS]->(beneficiary:Entity)-[:COUNTRY]->(beneficiaryCountry:Country)\nWHERE originCountry = beneficiaryCountry\nWITH originCountry, count(filing) AS filingsCount\nORDER BY filingsCount DESC\nLIMIT 5\nRETURN originCountry.name, filingsCount", "out_tokens": 96, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWITH f.originator_iso AS originatorCountry, f.beneficiary_iso AS beneficiaryCountry, count(*) AS filingCount\nWHERE originatorCountry = beneficiaryCountry\nWITH originatorCountry AS country, filingCount\nORDER BY filingCount DESC\nLIMIT 5\nMATCH (c:Country {code: country})\nRETURN c.name AS countryName, filingCount<|eot|>", "text": "MATCH (f:Filing)\nWITH f.originator_iso AS originatorCountry, f.beneficiary_iso AS beneficiaryCountry, count(*) AS filingCount\nWHERE originatorCountry = beneficiaryCountry\nWITH originatorCountry AS country, filingCount\nORDER BY filingCount DESC\nLIMIT 5\nMATCH (c:Country {code: country})\nRETURN c.name AS countryName, filingCount", "out_tokens": 78, "stop": "stop"}], "in_tokens": 726, "api_error": null}
{"id": "tr066", "cands": [{"raw": "MATCH (t:Tweet)-[:MENTIONS]->(u:User)\nWITH t, count(u) AS mention_count\nMATCH (t)-[:RETWEETS]->(retweeted_tweet:Tweet)\nWITH t, mention_count, count(retweeted_tweet) AS retweet_count\nMATCH (t)-[:REPLY_TO]->(reply_tweet:Tweet)\nWITH t, mention_count, retweet_count, count(reply_tweet) AS reply_count\nRETURN t, mention_count + retweet_count + reply_count AS total_interaction\nORDER BY total_interaction DESC\nLIMIT 5<|eot|>", "text": "MATCH (t:Tweet)-[:MENTIONS]->(u:User)\nWITH t, count(u) AS mention_count\nMATCH (t)-[:RETWEETS]->(retweeted_tweet:Tweet)\nWITH t, mention_count, count(retweeted_tweet) AS retweet_count\nMATCH (t)-[:REPLY_TO]->(reply_tweet:Tweet)\nWITH t, mention_count, retweet_count, count(reply_tweet) AS reply_count\nRETURN t, mention_count + retweet_count + reply_count AS total_interaction\nORDER BY total_interaction DESC\nLIMIT 5", "out_tokens": 123, "stop": "stop"}, {"raw": "MATCH (t:Tweet)\nWITH t, \n     size([(t)-[:MENTIONS]->() | 1]) + size([(t)-[:RETWEETS]->() | 1]) + size([(t)-[:REPLY_TO]->() | 1]) AS total_interactions\nRETURN t.text AS tweet_text, total_interactions\nORDER BY total_interactions DESC\nLIMIT 5<|eot|>", "text": "MATCH (t:Tweet)\nWITH t, \n     size([(t)-[:MENTIONS]->() | 1]) + size([(t)-[:RETWEETS]->() | 1]) + size([(t)-[:REPLY_TO]->() | 1]) AS total_interactions\nRETURN t.text AS tweet_text, total_interactions\nORDER BY total_interactions DESC\nLIMIT 5", "out_tokens": 80, "stop": "stop"}, {"raw": "MATCH (t:Tweet)\nWHERE t.id IS NOT NULL\nWITH t, \n     size([(t)-[:MENTIONS]->(u:User) | u]) AS mentions,\n     size([(t)-[:RETWEETS]->(r:Tweet) | r]) AS retweets,\n     size([(t)-[:REPLY_TO]->(re:Tweet) | re]) AS replies\nWITH t, mentions + retweets + replies AS totalInteractions\nORDER BY totalInteractions DESC\nLIMIT 5\nRETURN t.text AS tweetText, totalInteractions<|eot|>", "text": "MATCH (t:Tweet)\nWHERE t.id IS NOT NULL\nWITH t, \n     size([(t)-[:MENTIONS]->(u:User) | u]) AS mentions,\n     size([(t)-[:RETWEETS]->(r:Tweet) | r]) AS retweets,\n     size([(t)-[:REPLY_TO]->(re:Tweet) | re]) AS replies\nWITH t, mentions + retweets + replies AS totalInteractions\nORDER BY totalInteractions DESC\nLIMIT 5\nRETURN t.text AS tweetText, totalInteractions", "out_tokens": 112, "stop": "stop"}, {"raw": "MATCH (t:Tweet)\nWITH t, \n     size([(t)-[:MENTIONS]->() | 1]) AS mentions_count,\n     size([(t)-[:RETWEETS]->() | 1]) AS retweets_count,\n     size([(t)-[:REPLY_TO]->() | 1]) AS replies_count\nWITH t, mentions_count + retweets_count + replies_count AS total_interaction\nORDER BY total_interaction DESC\nLIMIT 5\nRETURN t.text AS tweet_text, total_interaction<|eot|>", "text": "MATCH (t:Tweet)\nWITH t, \n     size([(t)-[:MENTIONS]->() | 1]) AS mentions_count,\n     size([(t)-[:RETWEETS]->() | 1]) AS retweets_count,\n     size([(t)-[:REPLY_TO]->() | 1]) AS replies_count\nWITH t, mentions_count + retweets_count + replies_count AS total_interaction\nORDER BY total_interaction DESC\nLIMIT 5\nRETURN t.text AS tweet_text, total_interaction", "out_tokens": 105, "stop": "stop"}], "in_tokens": 838, "api_error": null}
