{"id": "tr418", "cands": [{"raw": "MATCH (u:User)-[s:SIMILAR_TO]->(m:Me {screen_name: 'neo4j'})\nRETURN u.name AS user_name, s.score AS similarity_score\nORDER BY s.score DESC\nLIMIT 5<|eot|>", "text": "MATCH (u:User)-[s:SIMILAR_TO]->(m:Me {screen_name: 'neo4j'})\nRETURN u.name AS user_name, s.score AS similarity_score\nORDER BY s.score DESC\nLIMIT 5", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (u:User)-[s:SIMILAR_TO]->(m:Me {screen_name: 'neo4j'})\nRETURN u.name AS user_name, s.score AS similarity_score\nORDER BY s.score DESC\nLIMIT 5<|eot|>", "text": "MATCH (u:User)-[s:SIMILAR_TO]->(m:Me {screen_name: 'neo4j'})\nRETURN u.name AS user_name, s.score AS similarity_score\nORDER BY s.score DESC\nLIMIT 5", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})\nMATCH (neo4j)-[r:SIMILAR_TO]->(user:User)\nRETURN user.name, r.score\nORDER BY r.score DESC\nLIMIT 5<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})\nMATCH (neo4j)-[r:SIMILAR_TO]->(user:User)\nRETURN user.name, r.score\nORDER BY r.score DESC\nLIMIT 5", "out_tokens": 51, "stop": "stop"}, {"raw": "MATCH (me:Me {name: 'Neo4j'})<-[s:SIMILAR_TO]-(user:User)\nRETURN user.name, s.score\nORDER BY s.score DESC\nLIMIT 5<|eot|>", "text": "MATCH (me:Me {name: 'Neo4j'})<-[s:SIMILAR_TO]-(user:User)\nRETURN user.name, s.score\nORDER BY s.score DESC\nLIMIT 5", "out_tokens": 43, "stop": "stop"}], "in_tokens": 842, "api_error": null}
{"id": "tr419", "cands": [{"raw": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'Singapore'\nWITH e, sum(f.amount) AS total_amount\nORDER BY total_amount DESC\nLIMIT 5\nRETURN e.name AS entity_name, total_amount<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'Singapore'\nWITH e, sum(f.amount) AS total_amount\nORDER BY total_amount DESC\nLIMIT 5\nRETURN e.name AS entity_name, total_amount", "out_tokens": 57, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'Singapore'\nWITH e.name AS entity_name, SUM(f.amount) AS total_amount\nORDER BY total_amount DESC\nLIMIT 5\nRETURN entity_name, total_amount<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'Singapore'\nWITH e.name AS entity_name, SUM(f.amount) AS total_amount\nORDER BY total_amount DESC\nLIMIT 5\nRETURN entity_name, total_amount", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'Singapore'\nRETURN e.name, sum(f.amount) AS totalAmount\nORDER BY totalAmount DESC\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)\nWHERE f.beneficiary_bank_country = 'Singapore'\nRETURN e.name, sum(f.amount) AS totalAmount\nORDER BY totalAmount DESC\nLIMIT 5", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity), (f)-[:CONCERNS]->(b:Entity)-[:COUNTRY]->(c:Country)\nWHERE c.name = 'Singapore'\nRETURN e.name, sum(f.amount) AS total_amount\nORDER BY total_amount DESC\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity), (f)-[:CONCERNS]->(b:Entity)-[:COUNTRY]->(c:Country)\nWHERE c.name = 'Singapore'\nRETURN e.name, sum(f.amount) AS total_amount\nORDER BY total_amount DESC\nLIMIT 5", "out_tokens": 66, "stop": "stop"}], "in_tokens": 731, "api_error": null}
{"id": "tr420", "cands": [{"raw": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE m.runtime > 120\nRETURN g.name AS genre, COUNT(m) AS movie_count\nORDER BY movie_count DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE m.runtime > 120\nRETURN g.name AS genre, COUNT(m) AS movie_count\nORDER BY movie_count DESC\nLIMIT 3", "out_tokens": 45, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.runtime > 120\nMATCH (m)-[:IN_GENRE]->(g:Genre)\nWITH g.name AS genre, count(*) AS count\nORDER BY count DESC\nLIMIT 3\nRETURN genre, count<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.runtime > 120\nMATCH (m)-[:IN_GENRE]->(g:Genre)\nWITH g.name AS genre, count(*) AS count\nORDER BY count DESC\nLIMIT 3\nRETURN genre, count", "out_tokens": 51, "stop": "stop"}, {"raw": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE m.runtime > 120\nRETURN g.name AS genre, count(*) AS movieCount\nORDER BY movieCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE m.runtime > 120\nRETURN g.name AS genre, count(*) AS movieCount\nORDER BY movieCount DESC\nLIMIT 3", "out_tokens": 44, "stop": "stop"}, {"raw": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE m.runtime > 120\nRETURN g.name AS genre, count(m) AS movieCount\nORDER BY movieCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE m.runtime > 120\nRETURN g.name AS genre, count(m) AS movieCount\nORDER BY movieCount DESC\nLIMIT 3", "out_tokens": 45, "stop": "stop"}], "in_tokens": 1093, "api_error": null}
