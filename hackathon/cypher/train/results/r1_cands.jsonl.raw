{"id": "tr353", "cands": [{"raw": "MATCH (t:Tweet)-[:USING]->(s:Source)\nRETURN s.name AS source_name, count(t) AS usage_count\nORDER BY usage_count DESC\nLIMIT 3<|eot|>", "text": "MATCH (t:Tweet)-[:USING]->(s:Source)\nRETURN s.name AS source_name, count(t) AS usage_count\nORDER BY usage_count DESC\nLIMIT 3", "out_tokens": 37, "stop": "stop"}, {"raw": "MATCH (t:Tweet)-[:USING]->(s:Source)\nRETURN s.name AS Source, count(*) AS UsageCount\nORDER BY UsageCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (t:Tweet)-[:USING]->(s:Source)\nRETURN s.name AS Source, count(*) AS UsageCount\nORDER BY UsageCount DESC\nLIMIT 3", "out_tokens": 35, "stop": "stop"}, {"raw": "MATCH (t:Tweet)-[:USING]->(s:Source)\nRETURN s.name AS source_name, COUNT(t) AS tweet_count\nORDER BY tweet_count DESC\nLIMIT 3<|eot|>", "text": "MATCH (t:Tweet)-[:USING]->(s:Source)\nRETURN s.name AS source_name, COUNT(t) AS tweet_count\nORDER BY tweet_count DESC\nLIMIT 3", "out_tokens": 37, "stop": "stop"}, {"raw": "MATCH (t:Tweet)-[:USING]->(s:Source)\nRETURN s.name AS source_name, COUNT(t) AS tweet_count\nORDER BY tweet_count DESC\nLIMIT 3<|eot|>", "text": "MATCH (t:Tweet)-[:USING]->(s:Source)\nRETURN s.name AS source_name, COUNT(t) AS tweet_count\nORDER BY tweet_count DESC\nLIMIT 3", "out_tokens": 37, "stop": "stop"}], "in_tokens": 835, "api_error": null}
{"id": "tr354", "cands": [{"raw": "MATCH (p:Product)\nWHERE p.unitPrice >= 10 AND p.unitPrice <= 20 AND p.discontinued = true\nRETURN p.productName, p.unitPrice\nLIMIT 3<|eot|>", "text": "MATCH (p:Product)\nWHERE p.unitPrice >= 10 AND p.unitPrice <= 20 AND p.discontinued = true\nRETURN p.productName, p.unitPrice\nLIMIT 3", "out_tokens": 39, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWHERE p.unitPrice >= 10 AND p.unitPrice <= 20 AND p.discontinued = true\nRETURN p.productName, p.unitPrice, p.discontinued\nLIMIT 3<|eot|>", "text": "MATCH (p:Product)\nWHERE p.unitPrice >= 10 AND p.unitPrice <= 20 AND p.discontinued = true\nRETURN p.productName, p.unitPrice, p.discontinued\nLIMIT 3", "out_tokens": 43, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWHERE p.unitPrice >= 10 AND p.unitPrice <= 20 AND p.discontinued = true\nRETURN p\nLIMIT 3<|eot|>", "text": "MATCH (p:Product)\nWHERE p.unitPrice >= 10 AND p.unitPrice <= 20 AND p.discontinued = true\nRETURN p\nLIMIT 3", "out_tokens": 33, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWHERE p.unitPrice >= 10 AND p.unitPrice <= 20 AND p.discontinued = true\nRETURN p\nORDER BY p.productID\nLIMIT 3<|eot|>", "text": "MATCH (p:Product)\nWHERE p.unitPrice >= 10 AND p.unitPrice <= 20 AND p.discontinued = true\nRETURN p\nORDER BY p.productID\nLIMIT 3", "out_tokens": 39, "stop": "stop"}], "in_tokens": 1267, "api_error": null}
{"id": "tr355", "cands": [{"raw": "MATCH (m:Movie)\nWITH m\nORDER BY m.revenue DESC\nLIMIT 1\nMATCH (u:User)-[r:RATED]->(m)\nRETURN u.name AS userName, r.rating AS rating\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)\nWITH m\nORDER BY m.revenue DESC\nLIMIT 1\nMATCH (u:User)-[r:RATED]->(m)\nRETURN u.name AS userName, r.rating AS rating\nLIMIT 3", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (m:Movie)-[:RATED]-(u:User)\nWITH m, u\nORDER BY m.revenue DESC\nLIMIT 1\nRETURN u.name AS user, m.title AS movie, m.revenue AS revenue<|eot|>", "text": "MATCH (m:Movie)-[:RATED]-(u:User)\nWITH m, u\nORDER BY m.revenue DESC\nLIMIT 1\nRETURN u.name AS user, m.title AS movie, m.revenue AS revenue", "out_tokens": 47, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[r:RATED]-(u:User)\nWITH m.revenue AS revenue, u, r\nORDER BY revenue DESC\nLIMIT 1\nRETURN u.name, r.rating<|eot|>", "text": "MATCH (m:Movie)<-[r:RATED]-(u:User)\nWITH m.revenue AS revenue, u, r\nORDER BY revenue DESC\nLIMIT 1\nRETURN u.name, r.rating", "out_tokens": 42, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWITH m\nORDER BY m.revenue DESC\nLIMIT 1\nMATCH (u:User)-[r:RATED]->(m)\nRETURN u.name AS user, r.rating AS rating\nORDER BY r.timestamp DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)\nWITH m\nORDER BY m.revenue DESC\nLIMIT 1\nMATCH (u:User)-[r:RATED]->(m)\nRETURN u.name AS user, r.rating AS rating\nORDER BY r.timestamp DESC\nLIMIT 3", "out_tokens": 54, "stop": "stop"}], "in_tokens": 1088, "api_error": null}
