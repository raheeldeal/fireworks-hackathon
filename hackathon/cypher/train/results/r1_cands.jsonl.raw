{"id": "tr000", "cands": [{"raw": "MATCH (me:Me)-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweeted:Tweet)\nRETURN retweeted.text, retweeted.created_at\nLIMIT 3<|eot|>", "text": "MATCH (me:Me)-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweeted:Tweet)\nRETURN retweeted.text, retweeted.created_at\nLIMIT 3", "out_tokens": 42, "stop": "stop"}, {"raw": "MATCH (me:Me)-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweeted_tweet:Tweet)\nRETURN retweeted_tweet.text, retweeted_tweet.created_at\nORDER BY retweeted_tweet.created_at DESC\nLIMIT 3<|eot|>", "text": "MATCH (me:Me)-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweeted_tweet:Tweet)\nRETURN retweeted_tweet.text, retweeted_tweet.created_at\nORDER BY retweeted_tweet.created_at DESC\nLIMIT 3", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (me:Me)-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweeted_tweet:Tweet)\nRETURN retweeted_tweet.text AS retweeted_tweet_text\nORDER BY tweet.created_at DESC\nLIMIT 3<|eot|>", "text": "MATCH (me:Me)-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweeted_tweet:Tweet)\nRETURN retweeted_tweet.text AS retweeted_tweet_text\nORDER BY tweet.created_at DESC\nLIMIT 3", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (me:Me)-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(original:Tweet)\nRETURN tweet\nORDER BY tweet.created_at DESC\nLIMIT 3<|eot|>", "text": "MATCH (me:Me)-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(original:Tweet)\nRETURN tweet\nORDER BY tweet.created_at DESC\nLIMIT 3", "out_tokens": 38, "stop": "stop"}], "in_tokens": 834, "api_error": null}
{"id": "tr001", "cands": [{"raw": "MATCH (f:Filing)\nWHERE datetime(f.begin_date_format) >= datetime('2015-01-01T00:00:00Z') AND datetime(f.begin_date_format) <= datetime('2015-12-31T23:59:59Z')\nRETURN f\nORDER BY f.number DESC\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)\nWHERE datetime(f.begin_date_format) >= datetime('2015-01-01T00:00:00Z') AND datetime(f.begin_date_format) <= datetime('2015-12-31T23:59:59Z')\nRETURN f\nORDER BY f.number DESC\nLIMIT 5", "out_tokens": 66, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2015-01-01T00:00:00Z') AND f.begin < datetime('2016-01-01T00:00:00Z')\nRETURN f\nORDER BY f.number DESC\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2015-01-01T00:00:00Z') AND f.begin < datetime('2016-01-01T00:00:00Z')\nRETURN f\nORDER BY f.number DESC\nLIMIT 5", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2015-01-01T00:00:00Z') AND f.begin < datetime('2016-01-01T00:00:00Z')\nRETURN f\nORDER BY f.number DESC\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2015-01-01T00:00:00Z') AND f.begin < datetime('2016-01-01T00:00:00Z')\nRETURN f\nORDER BY f.number DESC\nLIMIT 5", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2015-01-01T00:00:00Z') AND f.begin < datetime('2016-01-01T00:00:00Z')\nRETURN f\nORDER BY f.number DESC\nLIMIT 5<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2015-01-01T00:00:00Z') AND f.begin < datetime('2016-01-01T00:00:00Z')\nRETURN f\nORDER BY f.number DESC\nLIMIT 5", "out_tokens": 58, "stop": "stop"}], "in_tokens": 724, "api_error": null}
{"id": "tr002", "cands": [{"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE size(genres) > 1\nRETURN d.name AS Director, genres\nORDER BY size(genres) DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE size(genres) > 1\nRETURN d.name AS Director, genres\nORDER BY size(genres) DESC\nLIMIT 3", "out_tokens": 66, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, count(DISTINCT g) AS genreCount\nWHERE genreCount > 1\nRETURN d.name, genreCount\nORDER BY genreCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, count(DISTINCT g) AS genreCount\nWHERE genreCount > 1\nRETURN d.name, genreCount\nORDER BY genreCount DESC\nLIMIT 3", "out_tokens": 61, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->\n(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE size(genres) > 1\nRETURN d.name, genres\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->\n(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE size(genres) > 1\nRETURN d.name, genres\nLIMIT 3", "out_tokens": 56, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, count(DISTINCT g) AS genreCount\nWHERE genreCount > 1\nRETURN d.name AS directorName, genreCount\nORDER BY genreCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, count(DISTINCT g) AS genreCount\nWHERE genreCount > 1\nRETURN d.name AS directorName, genreCount\nORDER BY genreCount DESC\nLIMIT 3", "out_tokens": 64, "stop": "stop"}], "in_tokens": 1089, "api_error": null}
{"id": "tr003", "cands": [{"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWHERE o.shipCountry = 'USA'\nRETURN sum(toFloat(rel.quantity) * toFloat(rel.unitPrice)) AS totalRevenue<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWHERE o.shipCountry = 'USA'\nRETURN sum(toFloat(rel.quantity) * toFloat(rel.unitPrice)) AS totalRevenue", "out_tokens": 42, "stop": "stop"}, {"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWHERE o.shipCountry = 'USA'\nWITH sum(toFloat(rel.quantity) * toFloat(rel.unitPrice) * (1 - toFloat(rel.discount) / 100)) AS totalRevenue\nRETURN totalRevenue<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWHERE o.shipCountry = 'USA'\nWITH sum(toFloat(rel.quantity) * toFloat(rel.unitPrice) * (1 - toFloat(rel.discount) / 100)) AS totalRevenue\nRETURN totalRevenue", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWHERE o.shipCountry = 'USA'\nWITH o, r, p, toFloat(r.quantity) * toFloat(r.unitPrice) * (1 - toFloat(r.discount)) AS revenue\nRETURN sum(revenue) AS totalRevenue<|eot|>", "text": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWHERE o.shipCountry = 'USA'\nWITH o, r, p, toFloat(r.quantity) * toFloat(r.unitPrice) * (1 - toFloat(r.discount)) AS revenue\nRETURN sum(revenue) AS totalRevenue", "out_tokens": 64, "stop": "stop"}, {"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWHERE o.shipCountry = 'USA'\nWITH sum(toInteger(rel.quantity) * toFloat(rel.unitPrice)) AS totalRevenueUSA\nRETURN totalRevenueUSA<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWHERE o.shipCountry = 'USA'\nWITH sum(toInteger(rel.quantity) * toFloat(rel.unitPrice)) AS totalRevenueUSA\nRETURN totalRevenueUSA", "out_tokens": 48, "stop": "stop"}], "in_tokens": 1257, "api_error": null}
