{"id": "tr439", "cands": [{"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})\nMATCH (neo4j)-[:POSTS]->(tweet:Tweet)<-[:REPLY_TO]-(replyingTweet:Tweet)<-[:POSTS]-(replyingUser:User)\nWITH avg(replyingUser.followers) AS avgFollowers\nRETURN avgFollowers<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})\nMATCH (neo4j)-[:POSTS]->(tweet:Tweet)<-[:REPLY_TO]-(replyingTweet:Tweet)<-[:POSTS]-(replyingUser:User)\nWITH avg(replyingUser.followers) AS avgFollowers\nRETURN avgFollowers", "out_tokens": 71, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)<-[:REPLY_TO]-(reply:Tweet)-[:POSTS]->(user:User)\nWITH avg(user.followers) AS average_followers\nRETURN average_followers<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)<-[:REPLY_TO]-(reply:Tweet)-[:POSTS]->(user:User)\nWITH avg(user.followers) AS average_followers\nRETURN average_followers", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)\nMATCH (tweet)<-[:REPLY_TO]-(reply:Tweet)\nMATCH (reply)<-[:POSTS]-(replier:User)\nWITH avg(replier.followers) AS average_followers\nRETURN average_followers<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)\nMATCH (tweet)<-[:REPLY_TO]-(reply:Tweet)\nMATCH (reply)<-[:POSTS]-(replier:User)\nWITH avg(replier.followers) AS average_followers\nRETURN average_followers", "out_tokens": 72, "stop": "stop"}, {"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)\nWITH tweet\nMATCH (replier:User)-[:REPLY_TO]->(tweet)\nWITH collect(DISTINCT replier) AS repliers\nWITH avg(replier.followers) AS average_followers\nRETURN average_followers<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)\nWITH tweet\nMATCH (replier:User)-[:REPLY_TO]->(tweet)\nWITH collect(DISTINCT replier) AS repliers\nWITH avg(replier.followers) AS average_followers\nRETURN average_followers", "out_tokens": 72, "stop": "stop