{"id": "tr486", "cands": [{"raw": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWITH u, avg(r.rating) AS averageRating, count(r) AS ratingsCount\nWHERE ratingsCount >= 20\nRETURN u, averageRating\nORDER BY averageRating DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWITH u, avg(r.rating) AS averageRating, count(r) AS ratingsCount\nWHERE ratingsCount >= 20\nRETURN u, averageRating\nORDER BY averageRating DESC\nLIMIT 3", "out_tokens": 56, "stop": "stop"}, {"raw": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWITH u, avg(r.rating) AS averageRating, count(r) AS numberRated\nWHERE numberRated >= 20\nRETURN u.name, averageRating\nORDER BY averageRating DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWITH u, avg(r.rating) AS averageRating, count(r) AS numberRated\nWHERE numberRated >= 20\nRETURN u.name, averageRating\nORDER BY averageRating DESC\nLIMIT 3", "out_tokens": 57, "stop": "stop"}, {"raw": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWITH u, avg(r.rating) AS avgRating, count(r) AS numRatings\nWHERE numRatings >= 20\nRETURN u.name, avgRating, numRatings\nORDER BY avgRating DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWITH u, avg(r.rating) AS avgRating, count(r) AS numRatings\nWHERE numRatings >= 20\nRETURN u.name, avgRating, numRatings\nORDER BY avgRating DESC\nLIMIT 3", "out_tokens": 60, "stop": "stop"}, {"raw": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWITH u, avg(r.rating) AS averageRating, count(r) AS numberOfRatings\nWHERE numberOfRatings >= 20\nRETURN u.name AS userName, averageRating\nORDER BY averageRating DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User)-[r:RATED]->(m:Movie)\nWITH u, avg(r.rating) AS averageRating, count(r) AS numberOfRatings\nWHERE numberOfRatings >= 20\nRETURN u.name AS userName, averageRating\nORDER BY averageRating DESC\nLIMIT 3", "out_tokens": 62, "stop": "stop"}], "in_tokens": 1094, "api_error": null}
