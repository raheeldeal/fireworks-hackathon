{"id": "tr224", "cands": [{"raw": "MATCH (p:Person)-[:WROTE]->(m:Movie)\nWITH p, collect(m) AS writtenMovies\nMATCH (p)-[:DIRECTED]->(m:Movie)\nWITH p, writtenMovies, collect(m) AS directedMovies\nWHERE size(apoc.coll.intersection(writtenMovies, directedMovies)) > 0\nRETURN p.name<|eot|>", "text": "MATCH (p:Person)-[:WROTE]->(m:Movie)\nWITH p, collect(m) AS writtenMovies\nMATCH (p)-[:DIRECTED]->(m:Movie)\nWITH p, writtenMovies, collect(m) AS directedMovies\nWHERE size(apoc.coll.intersection(writtenMovies, directedMovies)) > 0\nRETURN p.name", "out_tokens": 73, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:WROTE]->(m:Movie)\nMATCH (p)-[:DIRECTED]->(m)\nRETURN DISTINCT p.name<|eot|>", "text": "MATCH (p:Person)-[:WROTE]->(m:Movie)\nMATCH (p)-[:DIRECTED]->(m)\nRETURN DISTINCT p.name", "out_tokens": 31, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:WROTE]->(m:Movie)\nWITH p\nMATCH (p)-[:DIRECTED]->(:Movie)\nRETURN DISTINCT p.name<|eot|>", "text": "MATCH (p:Person)-[:WROTE]->(m:Movie)\nWITH p\nMATCH (p)-[:DIRECTED]->(:Movie)\nRETURN DISTINCT p.name", "out_tokens": 34, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:WROTE]->(m:Movie)\nMATCH (p)-[:DIRECTED]->(m)\nRETURN DISTINCT p.name<|eot|>", "text": "MATCH (p:Person)-[:WROTE]->(m:Movie)\nMATCH (p)-[:DIRECTED]->(m)\nRETURN DISTINCT p.name", "out_tokens": 31, "stop": "stop"}], "in_tokens": 377, "api_error": null}
