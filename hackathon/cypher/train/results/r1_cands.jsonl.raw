{"id": "tr016", "cands": [{"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE d.born > date('1970-01-01')\nRETURN m.title AS movieTitle, d.name AS directorName, d.born AS directorBorn\nORDER BY m.released DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE d.born > date('1970-01-01')\nRETURN m.title AS movieTitle, d.name AS directorName, d.born AS directorBorn\nORDER BY m.released DESC\nLIMIT 3", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE d.born > date('1970-01-01')\nRETURN m.title, m.released\nORDER BY m.released DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE d.born > date('1970-01-01')\nRETURN m.title, m.released\nORDER BY m.released DESC\nLIMIT 3", "out_tokens": 47, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[:DIRECTED]-(d:Director)\nWHERE d.born > date('1970-01-01')\nRETURN m\nORDER BY m.released DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)<-[:DIRECTED]-(d:Director)\nWHERE d.born > date('1970-01-01')\nRETURN m\nORDER BY m.released DESC\nLIMIT 3", "out_tokens": 43, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE d.born > date('1970-01-01')\nRETURN m.title AS movieTitle, m.released AS releaseDate\nORDER BY m.released DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)\nWHERE d.born > date('1970-01-01')\nRETURN m.title AS movieTitle, m.released AS releaseDate\nORDER BY m.released DESC\nLIMIT 3", "out_tokens": 53, "stop": "stop"}], "in_tokens": 1093, "api_error": null}
