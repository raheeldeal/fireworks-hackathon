{"id": "tr187", "cands": [{"raw": "MATCH (u:User {screen_name: 'neo4j'})\nWITH u\nMATCH (u)-[r:SIMILAR_TO]->(similarUser:User)\nWHERE similarUser.screen_name CONTAINS 'neo4j'\nRETURN similarUser.screen_name, r.score\nORDER BY r.score DESC\nLIMIT 5<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})\nWITH u\nMATCH (u)-[r:SIMILAR_TO]->(similarUser:User)\nWHERE similarUser.screen_name CONTAINS 'neo4j'\nRETURN similarUser.screen_name, r.score\nORDER BY r.score DESC\nLIMIT 5", "out_tokens": 66, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'neo4j'})\nWITH u\nMATCH (u)-[s:SIMILAR_TO]->(otherUser:User)\nWHERE otherUser.screen_name <> 'neo4j'\nRETURN otherUser.screen_name, s.score\nORDER BY s.score DESC\nLIMIT 5<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})\nWITH u\nMATCH (u)-[s:SIMILAR_TO]->(otherUser:User)\nWHERE otherUser.screen_name <> 'neo4j'\nRETURN otherUser.screen_name, s.score\nORDER BY s.score DESC\nLIMIT 5", "out_tokens": 64, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'Neo4j'})-[:SIMILAR_TO]-(similar:User)\nRETURN similar.screen_name, similar.betweenness\nORDER BY similar.betweenness DESC\nLIMIT 5<|eot|>", "text": "MATCH (u:User {screen_name: 'Neo4j'})-[:SIMILAR_TO]-(similar:User)\nRETURN similar.screen_name, similar.betweenness\nORDER BY similar.betweenness DESC\nLIMIT 5", "out_tokens": 47, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'neo4j'})-[:SIMILAR_TO]-(v:User)\nRETURN v.name AS similar_user, u.screen_name AS original_user\nORDER BY v.screen_name\nLIMIT 5<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})-[:SIMILAR_TO]-(v:User)\nRETURN v.name AS similar_user, u.screen_name AS original_user\nORDER BY v.screen_name\nLIMIT 5", "out_tokens": 49, "stop": "stop"}], "in_tokens": 836, "api_error": null}
