{"id": "tr379", "cands": [{"raw": "MATCH (p:Person)-[:ACTED_IN]->(m:Movie)<-[:DIRECTED]-(p)\nWITH p, count(DISTINCT m) AS movieCount\nWHERE movieCount >= 1\nRETURN p.name AS actorDirector, movieCount\nORDER BY movieCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (p:Person)-[:ACTED_IN]->(m:Movie)<-[:DIRECTED]-(p)\nWITH p, count(DISTINCT m) AS movieCount\nWHERE movieCount >= 1\nRETURN p.name AS actorDirector, movieCount\nORDER BY movieCount DESC\nLIMIT 3", "out_tokens": 63, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:ACTED_IN]->(m:Movie)<-[:DIRECTED]-(p)\nWITH p,count(m) as moviesCount\nORDER BY moviesCount DESC\nLIMIT 3\nRETURN p.name<|eot|>", "text": "MATCH (p:Person)-[:ACTED_IN]->(m:Movie)<-[:DIRECTED]-(p)\nWITH p,count(m) as moviesCount\nORDER BY moviesCount DESC\nLIMIT 3\nRETURN p.name", "out_tokens": 46, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:ACTED_IN]->(m:Movie)<-[:DIRECTED]-(p)\nRETURN p.name AS actor, m.title AS movie\nORDER BY actor, movie\nLIMIT 3<|eot|>", "text": "MATCH (p:Person)-[:ACTED_IN]->(m:Movie)<-[:DIRECTED]-(p)\nRETURN p.name AS actor, m.title AS movie\nORDER BY actor, movie\nLIMIT 3", "out_tokens": 44, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:ACTED_IN]->(m:Movie)<-[:DIRECTED]-(p)\nWITH p, count(DISTINCT m) AS movies_count\nORDER BY movies_count DESC\nLIMIT 3\nRETURN p.name<|eot|>", "text": "MATCH (p:Person)-[:ACTED_IN]->(m:Movie)<-[:DIRECTED]-(p)\nWITH p, count(DISTINCT m) AS movies_count\nORDER BY movies_count DESC\nLIMIT 3\nRETURN p.name", "out_tokens": 50, "stop": "stop"}], "in_tokens": 1093, "api_error": null}
