{"id": "tr280", "cands": [{"raw": "MATCH (m:Movie)-[:DIRECTED]-(d:Person)\nWHERE m.tagline CONTAINS 'Houston'\nRETURN d.name AS Director, count(m) AS MovieCount\nORDER BY MovieCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)-[:DIRECTED]-(d:Person)\nWHERE m.tagline CONTAINS 'Houston'\nRETURN d.name AS Director, count(m) AS MovieCount\nORDER BY MovieCount DESC\nLIMIT 3", "out_tokens": 47, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.tagline CONTAINS 'Houston'\nWITH m\nMATCH (p:Person)-[:DIRECTED]->(m)\nWITH p, COUNT(m) AS numMovies\nORDER BY numMovies DESC\nLIMIT 3\nRETURN p.name AS directorName, numMovies<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.tagline CONTAINS 'Houston'\nWITH m\nMATCH (p:Person)-[:DIRECTED]->(m)\nWITH p, COUNT(m) AS numMovies\nORDER BY numMovies DESC\nLIMIT 3\nRETURN p.name AS directorName, numMovies", "out_tokens": 61, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.tagline CONTAINS 'Houston'\nMATCH (d:Person)-[:DIRECTED]->(m)\nRETURN d.name AS director, COUNT(m) AS moviesDirected\nORDER BY moviesDirected DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.tagline CONTAINS 'Houston'\nMATCH (d:Person)-[:DIRECTED]->(m)\nRETURN d.name AS director, COUNT(m) AS moviesDirected\nORDER BY moviesDirected DESC\nLIMIT 3", "out_tokens": 51, "stop": "stop"}, {"raw": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWHERE m.tagline CONTAINS 'Houston'\nRETURN d.name AS director_name, m.title AS movie_title, m.tagline AS tagline\nORDER BY m.title\nLIMIT 3<|eot|>", "text": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWHERE m.tagline CONTAINS 'Houston'\nRETURN d.name AS director_name, m.title AS movie_title, m.tagline AS tagline\nORDER BY m.title\nLIMIT 3", "out_tokens": 53, "stop": "stop"}], "in_tokens": 380, "api_error": null}
{"id": "tr281", "cands": [{"raw": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWITH e, count(f) AS filings_count\nWHERE filings_count > 5\nMATCH (e)-[:COUNTRY]->(c:Country)\nRETURN DISTINCT c.name<|eot|>", "text": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWITH e, count(f) AS filings_count\nWHERE filings_count > 5\nMATCH (e)-[:COUNTRY]->(c:Country)\nRETURN DISTINCT c.name", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWITH e, count(f) AS filingCount\nWHERE filingCount > 5\nMATCH (e)-[:COUNTRY]->(c:Country)\nRETURN DISTINCT c.name<|eot|>", "text": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWITH e, count(f) AS filingCount\nWHERE filingCount > 5\nMATCH (e)-[:COUNTRY]->(c:Country)\nRETURN DISTINCT c.name", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWITH e, count(f) AS filingCount\nWHERE filingCount > 5\nMATCH (e)-[:COUNTRY]->(c:Country)\nRETURN DISTINCT c.name<|eot|>", "text": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWITH e, count(f) AS filingCount\nWHERE filingCount > 5\nMATCH (e)-[:COUNTRY]->(c:Country)\nRETURN DISTINCT c.name", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWITH e, count(f) AS filing_count\nWHERE filing_count > 5\nMATCH (e)-[:COUNTRY]->(c:Country)\nRETURN DISTINCT c.name AS country_name<|eot|>", "text": "MATCH (e:Entity)-[:FILED]->(f:Filing)\nWITH e, count(f) AS filing_count\nWHERE filing_count > 5\nMATCH (e)-[:COUNTRY]->(c:Country)\nRETURN DISTINCT c.name AS country_name", "out_tokens": 52, "stop": "stop"}], "in_tokens": 720, "api_error": null}
{"id": "tr282", "cands": [{"raw": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2009-01-01T00:00:00Z') AND f.end <= datetime('2009-12-31T23:59:59Z')\nWITH duration.between(f.begin, f.end) AS duration, f\nORDER BY duration DESC\nLIMIT 3\nRETURN f, duration<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2009-01-01T00:00:00Z') AND f.end <= datetime('2009-12-31T23:59:59Z')\nWITH duration.between(f.begin, f.end) AS duration, f\nORDER BY duration DESC\nLIMIT 3\nRETURN f, duration", "out_tokens": 74, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2009-01-01T00:00:00Z') AND f.end <= datetime('2009-12-31T23:59:59Z')\nRETURN f, duration.between(f.begin, f.end) AS duration\nORDER BY duration DESC\nLIMIT 3<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2009-01-01T00:00:00Z') AND f.end <= datetime('2009-12-31T23:59:59Z')\nRETURN f, duration.between(f.begin, f.end) AS duration\nORDER BY duration DESC\nLIMIT 3", "out_tokens": 69, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2009-01-01T00:00:00Z') AND f.end <= datetime('2009-12-31T23:59:59Z')\nWITH f, duration.between(f.begin, f.end) AS duration\nORDER BY duration DESC\nLIMIT 3\nRETURN f, duration<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2009-01-01T00:00:00Z') AND f.end <= datetime('2009-12-31T23:59:59Z')\nWITH f, duration.between(f.begin, f.end) AS duration\nORDER BY duration DESC\nLIMIT 3\nRETURN f, duration", "out_tokens": 74, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2009-01-01T00:00:00Z') AND f.end <= datetime('2009-12-31T23:59:59Z')\nRETURN f\nORDER BY duration.between(f.begin, f.end) DESC\nLIMIT 3<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.begin >= datetime('2009-01-01T00:00:00Z') AND f.end <= datetime('2009-12-31T23:59:59Z')\nRETURN f\nORDER BY duration.between(f.begin, f.end) DESC\nLIMIT 3", "out_tokens": 65, "stop": "stop"}], "in_tokens": 723, "api_error": null}
