{"id": "tr481", "cands": [{"raw": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE m.released >= 1990 AND m.released < 2000\nUNWIND r.roles AS role\nRETURN role, COUNT(role) AS role_count\nORDER BY role_count DESC<|eot|>", "text": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE m.released >= 1990 AND m.released < 2000\nUNWIND r.roles AS role\nRETURN role, COUNT(role) AS role_count\nORDER BY role_count DESC", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE m.released >= 1990 AND m.released <= 1999\nUNWIND r.roles AS role\nRETURN role, COUNT(role) AS count\nORDER BY count DESC\nLIMIT 10<|eot|>", "text": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE m.released >= 1990 AND m.released <= 1999\nUNWIND r.roles AS role\nRETURN role, COUNT(role) AS count\nORDER BY count DESC\nLIMIT 10", "out_tokens": 60, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.released >= 1990 AND m.released < 2000\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nUNWIND r.roles AS role\nRETURN role AS Common_Role, COUNT(*) AS Number_Of_Appearances\nORDER BY Number_Of_Appearances DESC\nLIMIT 10<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.released >= 1990 AND m.released < 2000\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nUNWIND r.roles AS role\nRETURN role AS Common_Role, COUNT(*) AS Number_Of_Appearances\nORDER BY Number_Of_Appearances DESC\nLIMIT 10", "out_tokens": 77, "stop": "stop"}, {"raw": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE m.released >= 1990 AND m.released < 2000\nUNWIND r.roles AS role\nRETURN role, COUNT(*) AS role_count\nORDER BY role_count DESC\nLIMIT 10<|eot|>", "text": "MATCH (p:Person)-[r:ACTED_IN]->(m:Movie)\nWHERE m.released >= 1990 AND m.released < 2000\nUNWIND r.roles AS role\nRETURN role, COUNT(*) AS role_count\nORDER BY role_count DESC\nLIMIT 10", "out_tokens": 61, "stop": "stop"}], "in_tokens": 381, "api_error": null}
