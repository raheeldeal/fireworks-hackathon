{"id": "tr047", "cands": [{"raw": "MATCH (m:Movie)\nWHERE m.budget > 0 AND m.revenue > 0\nWITH m, (toFloat(m.budget) / toFloat(m.revenue)) AS budgetToRevenueRatio\nORDER BY budgetToRevenueRatio DESC\nLIMIT 3\nRETURN m.title, m.budget, m.revenue, budgetToRevenueRatio<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.budget > 0 AND m.revenue > 0\nWITH m, (toFloat(m.budget) / toFloat(m.revenue)) AS budgetToRevenueRatio\nORDER BY budgetToRevenueRatio DESC\nLIMIT 3\nRETURN m.title, m.budget, m.revenue, budgetToRevenueRatio", "out_tokens": 72, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.budget > 0 AND m.revenue > 0\nRETURN m\nORDER BY (m.budget / m.revenue) DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.budget > 0 AND m.revenue > 0\nRETURN m\nORDER BY (m.budget / m.revenue) DESC\nLIMIT 3", "out_tokens": 40, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.budget IS NOT NULL AND m.revenue IS NOT NULL AND m.revenue > 0\nWITH m, toFloat(m.budget) / toFloat(m.revenue) AS ratio\nORDER BY ratio DESC\nLIMIT 3\nRETURN m.title AS movie, ratio<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.budget IS NOT NULL AND m.revenue IS NOT NULL AND m.revenue > 0\nWITH m, toFloat(m.budget) / toFloat(m.revenue) AS ratio\nORDER BY ratio DESC\nLIMIT 3\nRETURN m.title AS movie, ratio", "out_tokens": 63, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.budget IS NOT NULL AND m.revenue IS NOT NULL AND m.revenue > 0\nWITH m, toFloat(m.budget) / toFloat(m.revenue) AS ratio\nORDER BY ratio DESC\nRETURN m.title AS title, m.budget AS budget, m.revenue AS revenue, ratio\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.budget IS NOT NULL AND m.revenue IS NOT NULL AND m.revenue > 0\nWITH m, toFloat(m.budget) / toFloat(m.revenue) AS ratio\nORDER BY ratio DESC\nRETURN m.title AS title, m.budget AS budget, m.revenue AS revenue, ratio\nLIMIT 3", "out_tokens": 75, "stop": "stop"}], "in_tokens": 1090, "api_error": null}
