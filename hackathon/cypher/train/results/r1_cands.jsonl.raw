{"id": "tr164", "cands": [{"raw": "MATCH (p:Product)-[:ORDERS]-(o:Order)\nWHERE p.categoryID = '2'\nRETURN p.productName, SUM(o.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nLIMIT 5<|eot|>", "text": "MATCH (p:Product)-[:ORDERS]-(o:Order)\nWHERE p.categoryID = '2'\nRETURN p.productName, SUM(o.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nLIMIT 5", "out_tokens": 45, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category {categoryName: 'Condiments'})\nMATCH (o:Order)-[rel:ORDERS]->(p)\nWITH p, sum(rel.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nLIMIT 5\nRETURN p.productName, totalQuantity<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category {categoryName: 'Condiments'})\nMATCH (o:Order)-[rel:ORDERS]->(p)\nWITH p, sum(rel.quantity) AS totalQuantity\nORDER BY totalQuantity DESC\nLIMIT 5\nRETURN p.productName, totalQuantity", "out_tokens": 65, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category {categoryName: 'Condiments'})\nMATCH (o:Order)-[rel:ORDERS]->(p)\nWITH p, sum(rel.quantity) AS totalQuantityOrdered\nORDER BY totalQuantityOrdered DESC\nLIMIT 5\nRETURN p.productName, totalQuantityOrdered<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category {categoryName: 'Condiments'})\nMATCH (o:Order)-[rel:ORDERS]->(p)\nWITH p, sum(rel.quantity) AS totalQuantityOrdered\nORDER BY totalQuantityOrdered DESC\nLIMIT 5\nRETURN p.productName, totalQuantityOrdered", "out_tokens": 68, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:ORDERS]-(o:Order)\nWHERE p.categoryID = '2'\nRETURN p.productName, sum(o.quantity) AS totalOrdered\nORDER BY totalOrdered DESC\nLIMIT 5<|eot|>", "text": "MATCH (p:Product)-[:ORDERS]-(o:Order)\nWHERE p.categoryID = '2'\nRETURN p.productName, sum(o.quantity) AS totalOrdered\nORDER BY totalOrdered DESC\nLIMIT 5", "out_tokens": 45, "stop": "stop"}], "in_tokens": 1262, "api_error": null}
{"id": "tr165", "cands": [{"raw": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[:DIRECTED]-(director:Director)\nMATCH (director)-[:DIRECTED]->(movie:Movie)\nMATCH (actor:Actor)-[:ACTED_IN]->(movie)\nRETURN DISTINCT actor.name<|eot|>", "text": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[:DIRECTED]-(director:Director)\nMATCH (director)-[:DIRECTED]->(movie:Movie)\nMATCH (actor:Actor)-[:ACTED_IN]->(movie)\nRETURN DISTINCT actor.name", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[:DIRECTED]-(director:Person)\nMATCH (director)-[:DIRECTED]->(movie:Movie)<-[:ACTED_IN]-(actor:Actor)\nRETURN DISTINCT actor.name AS actorName<|eot|>", "text": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[:DIRECTED]-(director:Person)\nMATCH (director)-[:DIRECTED]->(movie:Movie)<-[:ACTED_IN]-(actor:Actor)\nRETURN DISTINCT actor.name AS actorName", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (m:Movie {title: \"Toy Story\"})<-[:DIRECTED]-(director)\nMATCH (director)-[:DIRECTED]->(otherMovies:Movie)<-[:ACTED_IN]-(actor:Actor)\nRETURN DISTINCT actor.name AS actorName, collect(otherMovies.title) AS movies<|eot|>", "text": "MATCH (m:Movie {title: \"Toy Story\"})<-[:DIRECTED]-(director)\nMATCH (director)-[:DIRECTED]->(otherMovies:Movie)<-[:ACTED_IN]-(actor:Actor)\nRETURN DISTINCT actor.name AS actorName, collect(otherMovies.title) AS movies", "out_tokens": 60, "stop": "stop"}, {"raw": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[:DIRECTED]-(director)\nMATCH (director)-[:DIRECTED]->(movie)<-[:ACTED_IN]-(actor:Actor)\nRETURN DISTINCT actor.name AS actorName<|eot|>", "text": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[:DIRECTED]-(director)\nMATCH (director)-[:DIRECTED]->(movie)<-[:ACTED_IN]-(actor:Actor)\nRETURN DISTINCT actor.name AS actorName", "out_tokens": 55, "stop": "stop"}], "in_tokens": 1091, "api_error": null}
