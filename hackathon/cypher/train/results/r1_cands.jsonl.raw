{"id": "tr394", "cands": [{"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, count(distinct g) AS genresCount\nWHERE genresCount > 2\nRETURN d.name, genresCount\nORDER BY genresCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, count(distinct g) AS genresCount\nWHERE genresCount > 2\nRETURN d.name, genresCount\nORDER BY genresCount DESC\nLIMIT 3", "out_tokens": 60, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, COLLECT(DISTINCT g.name) AS genres\nWHERE SIZE(genres) > 2\nRETURN d.name, genres\nORDER BY SIZE(genres) DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, COLLECT(DISTINCT g.name) AS genres\nWHERE SIZE(genres) > 2\nRETURN d.name, genres\nORDER BY SIZE(genres) DESC\nLIMIT 3", "out_tokens": 65, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, count(DISTINCT g) AS genreCount\nWHERE genreCount > 2\nRETURN d.name AS directorName, genreCount\nORDER BY genreCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, count(DISTINCT g) AS genreCount\nWHERE genreCount > 2\nRETURN d.name AS directorName, genreCount\nORDER BY genreCount DESC\nLIMIT 3", "out_tokens": 64, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE size(genres) > 2\nRETURN d.name, genres\nORDER BY size(genres) DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE size(genres) > 2\nRETURN d.name, genres\nORDER BY size(genres) DESC\nLIMIT 3", "out_tokens": 64, "stop": "stop"}], "in_tokens": 1090, "api_error": null}
