{"id": "tr303", "cands": [{"raw": "MATCH (m:Movie)<-[r:REVIEWED]-()\nWITH m, avg(r.rating) AS averageRating\nORDER BY averageRating DESC\nRETURN m.title, averageRating\nLIMIT 1<|eot|>", "text": "MATCH (m:Movie)<-[r:REVIEWED]-()\nWITH m, avg(r.rating) AS averageRating\nORDER BY averageRating DESC\nRETURN m.title, averageRating\nLIMIT 1", "out_tokens": 41, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[r:REVIEWED]-()\nRETURN m.title, max(r.rating) AS maxRating\nORDER BY maxRating DESC\nLIMIT 1<|eot|>", "text": "MATCH (m:Movie)<-[r:REVIEWED]-()\nRETURN m.title, max(r.rating) AS maxRating\nORDER BY maxRating DESC\nLIMIT 1", "out_tokens": 35, "stop": "stop"}, {"raw": "MATCH (p:Person)-[r:REVIEWED]->(m:Movie)\nRETURN m.title AS MovieTitle, r.rating AS Rating\nORDER BY r.rating DESC\nLIMIT 1<|eot|>", "text": "MATCH (p:Person)-[r:REVIEWED]->(m:Movie)\nRETURN m.title AS MovieTitle, r.rating AS Rating\nORDER BY r.rating DESC\nLIMIT 1", "out_tokens": 39, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[r:REVIEWED]-()\nWITH m, avg(r.rating) AS average_rating\nORDER BY average_rating DESC\nRETURN m.title AS movie_title, average_rating\nLIMIT 1<|eot|>", "text": "MATCH (m:Movie)<-[r:REVIEWED]-()\nWITH m, avg(r.rating) AS average_rating\nORDER BY average_rating DESC\nRETURN m.title AS movie_title, average_rating\nLIMIT 1", "out_tokens": 44, "stop": "stop"}], "in_tokens": 373, "api_error": null}
