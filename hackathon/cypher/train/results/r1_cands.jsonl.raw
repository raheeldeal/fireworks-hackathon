{"id": "tr243", "cands": [{"raw": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:FOLLOWS]->(followedUser:User)\nMATCH (tweet:Tweet)-[:MENTIONS]->(followedUser)\nWITH avg(tweet.favorites) AS averageFavorites\nRETURN averageFavorites<|eot|>", "text": "MATCH (neo4j:User {screen_name: 'neo4j'})-[:FOLLOWS]->(followedUser:User)\nMATCH (tweet:Tweet)-[:MENTIONS]->(followedUser)\nWITH avg(tweet.favorites) AS averageFavorites\nRETURN averageFavorites", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:FOLLOWS]->(followed:User)\nMATCH (followed)<-[:MENTIONS]-(tweet:Tweet)\nWITH avg(tweet.favorites) AS average_favorites\nRETURN average_favorites<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:FOLLOWS]->(followed:User)\nMATCH (followed)<-[:MENTIONS]-(tweet:Tweet)\nWITH avg(tweet.favorites) AS average_favorites\nRETURN average_favorites", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (me:Me {name: \"Neo4j\"})\nMATCH (me)-[:FOLLOWS]->(user:User)\nMATCH (tweet:Tweet)-[:MENTIONS]->(user)\nWITH avg(tweet.favorites) AS averageFavorites\nRETURN averageFavorites<|eot|>", "text": "MATCH (me:Me {name: \"Neo4j\"})\nMATCH (me)-[:FOLLOWS]->(user:User)\nMATCH (tweet:Tweet)-[:MENTIONS]->(user)\nWITH avg(tweet.favorites) AS averageFavorites\nRETURN averageFavorites", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:FOLLOWS]->(u:User)<-[:MENTIONS]-(t:Tweet)\nWITH avg(t.favorites) AS average_favorites\nRETURN average_favorites<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:FOLLOWS]->(u:User)<-[:MENTIONS]-(t:Tweet)\nWITH avg(t.favorites) AS average_favorites\nRETURN average_favorites", "out_tokens": 51, "stop": "stop"}], "in_tokens": 837, "api_error": null}
{"id": "tr244", "cands": [{"raw": "MATCH (t:Tweet)-[:MENTIONS]->(u:User)\nWHERE u.betweenness > 1000\nMATCH (t)-[:USING]->(s:Source)\nWITH s.name AS source, count(*) AS count\nORDER BY count DESC\nRETURN source, count\nLIMIT 1<|eot|>", "text": "MATCH (t:Tweet)-[:MENTIONS]->(u:User)\nWHERE u.betweenness > 1000\nMATCH (t)-[:USING]->(s:Source)\nWITH s.name AS source, count(*) AS count\nORDER BY count DESC\nRETURN source, count\nLIMIT 1", "out_tokens": 61, "stop": "stop"}, {"raw": "MATCH (t:Tweet)-[:MENTIONS]->(u:User)\nWHERE u.betweenness > 1000\nMATCH (t)-[:USING]->(s:Source)\nRETURN s.name AS source, COUNT(*) AS count\nORDER BY count DESC\nLIMIT 1<|eot|>", "text": "MATCH (t:Tweet)-[:MENTIONS]->(u:User)\nWHERE u.betweenness > 1000\nMATCH (t)-[:USING]->(s:Source)\nRETURN s.name AS source, COUNT(*) AS count\nORDER BY count DESC\nLIMIT 1", "out_tokens": 56, "stop": "stop"}, {"raw": "MATCH (u:User)\nWHERE u.betweenness > 1000\nMATCH (tweet:Tweet)-[:MENTIONS]->(u)\nMATCH (tweet)-[:USING]->(source:Source)\nRETURN source.name AS source_name, COUNT(*) AS usage_count\nORDER BY usage_count DESC\nLIMIT 1<|eot|>", "text": "MATCH (u:User)\nWHERE u.betweenness > 1000\nMATCH (tweet:Tweet)-[:MENTIONS]->(u)\nMATCH (tweet)-[:USING]->(source:Source)\nRETURN source.name AS source_name, COUNT(*) AS usage_count\nORDER BY usage_count DESC\nLIMIT 1", "out_tokens": 63, "stop": "stop"}, {"raw": "MATCH (u:User)\nWHERE u.betweenness > 1000\nMATCH (t:Tweet)-[:MENTIONS]->(u)\nMATCH (t)-[:USING]->(s:Source)\nRETURN s.name AS source_name, count(t) AS tweet_count\nORDER BY tweet_count DESC\nLIMIT 1<|eot|>", "text": "MATCH (u:User)\nWHERE u.betweenness > 1000\nMATCH (t:Tweet)-[:MENTIONS]->(u)\nMATCH (t)-[:USING]->(s:Source)\nRETURN s.name AS source_name, count(t) AS tweet_count\nORDER BY tweet_count DESC\nLIMIT 1", "out_tokens": 64, "stop": "stop"}], "in_tokens": 842, "api_error": null}
{"id": "tr245", "cands": [{"raw": "MATCH (t:Tweet)-[:MENTIONS]->(u:User {screen_name: 'neo4j'})\nMATCH (t)-[:CONTAINS]->(l:Link)\nRETURN t.id_str AS tweet_id, t.text AS tweet_content, l.url AS link_url\nORDER BY t.favorites DESC\nLIMIT 5<|eot|>", "text": "MATCH (t:Tweet)-[:MENTIONS]->(u:User {screen_name: 'neo4j'})\nMATCH (t)-[:CONTAINS]->(l:Link)\nRETURN t.id_str AS tweet_id, t.text AS tweet_content, l.url AS link_url\nORDER BY t.favorites DESC\nLIMIT 5", "out_tokens": 67, "stop": "stop"}, {"raw": "MATCH (t:Tweet)-[:MENTIONS]->(u:User {screen_name: 'neo4j'})\nMATCH (t)-[:CONTAINS]->(l:Link)\nRETURN t.text AS Tweet, l.url AS Link\nORDER BY t.favorites DESC\nLIMIT 5<|eot|>", "text": "MATCH (t:Tweet)-[:MENTIONS]->(u:User {screen_name: 'neo4j'})\nMATCH (t)-[:CONTAINS]->(l:Link)\nRETURN t.text AS Tweet, l.url AS Link\nORDER BY t.favorites DESC\nLIMIT 5", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (t:Tweet)-[:MENTIONS]->(u:User {screen_name: 'neo4j'})\nMATCH (t)-[:CONTAINS]->(l:Link)\nRETURN t\nORDER BY t.favorites DESC\nLIMIT 5<|eot|>", "text": "MATCH (t:Tweet)-[:MENTIONS]->(u:User {screen_name: 'neo4j'})\nMATCH (t)-[:CONTAINS]->(l:Link)\nRETURN t\nORDER BY t.favorites DESC\nLIMIT 5", "out_tokens": 50, "stop": "stop"}, {"raw": "MATCH (t:Tweet)-[:MENTIONS]->(u:User {screen_name: 'neo4j'})\nMATCH (t)-[:CONTAINS]->(l:Link)\nRETURN t.text AS tweet, l.url AS link\nORDER BY t.favorites DESC\nLIMIT 5<|eot|>", "text": "MATCH (t:Tweet)-[:MENTIONS]->(u:User {screen_name: 'neo4j'})\nMATCH (t)-[:CONTAINS]->(l:Link)\nRETURN t.text AS tweet, l.url AS link\nORDER BY t.favorites DESC\nLIMIT 5", "out_tokens": 58, "stop": "stop"}], "in_tokens": 835, "api_error": null}
