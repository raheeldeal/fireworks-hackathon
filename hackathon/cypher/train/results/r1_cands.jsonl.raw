{"id": "tr368", "cands": [{"raw": "MATCH (p:Product)\nWITH avg(p.unitPrice) AS averagePrice\nMATCH (p:Product)\nWHERE p.unitPrice >= averagePrice * 0.9 AND p.unitPrice <= averagePrice * 1.1\nRETURN p.productName, p.unitPrice<|eot|>", "text": "MATCH (p:Product)\nWITH avg(p.unitPrice) AS averagePrice\nMATCH (p:Product)\nWHERE p.unitPrice >= averagePrice * 0.9 AND p.unitPrice <= averagePrice * 1.1\nRETURN p.productName, p.unitPrice", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWITH avg(p.unitPrice) AS avgUnitPrice\nMATCH (p:Product)\nWHERE p.unitPrice >= avgUnitPrice * 0.9 AND p.unitPrice <= avgUnitPrice * 1.1\nRETURN p.productName AS productName, p.unitPrice AS unitPrice<|eot|>", "text": "MATCH (p:Product)\nWITH avg(p.unitPrice) AS avgUnitPrice\nMATCH (p:Product)\nWHERE p.unitPrice >= avgUnitPrice * 0.9 AND p.unitPrice <= avgUnitPrice * 1.1\nRETURN p.productName AS productName, p.unitPrice AS unitPrice", "out_tokens": 64, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWITH avg(p.unitPrice) AS average_price\nMATCH (p:Product)\nWHERE p.unitPrice >= average_price * 0.9 AND p.unitPrice <= average_price * 1.1\nRETURN p.productName, p.unitPrice<|eot|>", "text": "MATCH (p:Product)\nWITH avg(p.unitPrice) AS average_price\nMATCH (p:Product)\nWHERE p.unitPrice >= average_price * 0.9 AND p.unitPrice <= average_price * 1.1\nRETURN p.productName, p.unitPrice", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWITH avg(p.unitPrice) AS averagePrice\nMATCH (p:Product)\nWHERE p.unitPrice >= averagePrice * 0.9 AND p.unitPrice <= averagePrice * 1.1\nRETURN p.productName<|eot|>", "text": "MATCH (p:Product)\nWITH avg(p.unitPrice) AS averagePrice\nMATCH (p:Product)\nWHERE p.unitPrice >= averagePrice * 0.9 AND p.unitPrice <= averagePrice * 1.1\nRETURN p.productName", "out_tokens": 51, "stop": "stop"}], "in_tokens": 1265, "api_error": null}
