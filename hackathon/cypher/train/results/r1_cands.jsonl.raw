{"id": "tr399", "cands": [{"raw": "MATCH (f:Filing)-[:ORIGINATOR]->(o:Entity)-[:COUNTRY]->(oc:Country)\nWHERE oc.code = \"SGP\"\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(bc:Country)\nWHERE bc.code = \"GBR\"\nWITH b.name AS beneficiary_bank, count(f) AS filings_count\nORDER BY filings_count DESC\nLIMIT 3\nRETURN beneficiary_bank, filings_count<|eot|>", "text": "MATCH (f:Filing)-[:ORIGINATOR]->(o:Entity)-[:COUNTRY]->(oc:Country)\nWHERE oc.code = \"SGP\"\nMATCH (f)-[:BENEFITS]->(b:Entity)-[:COUNTRY]->(bc:Country)\nWHERE bc.code = \"GBR\"\nWITH b.name AS beneficiary_bank, count(f) AS filings_count\nORDER BY filings_count DESC\nLIMIT 3\nRETURN beneficiary_bank, filings_count", "out_tokens": 94, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(b:Entity)\nWHERE f.originator_iso = \"SGP\" AND f.beneficiary_iso = \"GBR\"\nWITH b.name AS beneficiary_bank_name, count(*) AS filings_count\nORDER BY filings_count DESC\nLIMIT 3\nRETURN beneficiary_bank_name, filings_count<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(b:Entity)\nWHERE f.originator_iso = \"SGP\" AND f.beneficiary_iso = \"GBR\"\nWITH b.name AS beneficiary_bank_name, count(*) AS filings_count\nORDER BY filings_count DESC\nLIMIT 3\nRETURN beneficiary_bank_name, filings_count", "out_tokens": 68, "stop": "stop"}, {"raw": "MATCH (f:Filing)\nWHERE f.originator_iso = \"SGP\" AND f.beneficiary_iso = \"GBR\"\nWITH f.beneficiary_bank AS beneficiaryBank, count(*) AS filingsCount\nORDER BY filingsCount DESC\nLIMIT 3\nRETURN beneficiaryBank, filingsCount<|eot|>", "text": "MATCH (f:Filing)\nWHERE f.originator_iso = \"SGP\" AND f.beneficiary_iso = \"GBR\"\nWITH f.beneficiary_bank AS beneficiaryBank, count(*) AS filingsCount\nORDER BY filingsCount DESC\nLIMIT 3\nRETURN beneficiaryBank, filingsCount", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(beneficiary:Entity)-[:COUNTRY]->(beneficiaryCountry:Country)\nMATCH (f:Filing)-[:ORIGINATOR]->(originator:Entity)-[:COUNTRY]->(originatorCountry