{"id": "tr422", "cands": [{"raw": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre {name: 'Action'})\nWHERE size(m.languages) > 0\nRETURN m.title, m.languages, size(m.languages) AS numLanguages\nORDER BY numLanguages DESC\nLIMIT 5<|eot|>", "text": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre {name: 'Action'})\nWHERE size(m.languages) > 0\nRETURN m.title, m.languages, size(m.languages) AS numLanguages\nORDER BY numLanguages DESC\nLIMIT 5", "out_tokens": 57, "stop": "stop"}, {"raw": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name = 'Action'\nWITH m, size(m.languages) AS numLanguages\nORDER BY numLanguages DESC\nLIMIT 5\nRETURN m.title AS movieTitle, numLanguages<|eot|>", "text": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name = 'Action'\nWITH m, size(m.languages) AS numLanguages\nORDER BY numLanguages DESC\nLIMIT 5\nRETURN m.title AS movieTitle, numLanguages", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name = 'Action'\nRETURN m.title AS movie, size(m.languages) AS num_languages\nORDER BY num_languages DESC\nLIMIT 5<|eot|>", "text": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name = 'Action'\nRETURN m.title AS movie, size(m.languages) AS num_languages\nORDER BY num_languages DESC\nLIMIT 5", "out_tokens": 49, "stop": "stop"}, {"raw": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name = 'Action'\nWITH m, size(m.languages) AS languageCount\nORDER BY languageCount DESC\nLIMIT 5\nRETURN m.title, languageCount<|eot|>", "text": "MATCH (m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name = 'Action'\nWITH m, size(m.languages) AS languageCount\nORDER BY languageCount DESC\nLIMIT 5\nRETURN m.title, languageCount", "out_tokens": 51, "stop": "stop"}], "in_tokens": 1096, "api_error": null}
{"id": "tr423", "cands": [{"raw": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[:ORDERS]->(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, COUNT(DISTINCT s) AS numSuppliers\nORDER BY numSuppliers DESC\nLIMIT 10\nRETURN c, numSuppliers<|eot|>", "text": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[:ORDERS]->(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, COUNT(DISTINCT s) AS numSuppliers\nORDER BY numSuppliers DESC\nLIMIT 10\nRETURN c, numSuppliers", "out_tokens": 68, "stop": "stop"}, {"raw": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[:ORDERS]->(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, count(DISTINCT s) AS distinctSupplierCount\nORDER BY distinctSupplierCount DESC\nLIMIT 10\nRETURN c.companyName AS customerName, distinctSupplierCount<|eot|>", "text": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[:ORDERS]->(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, count(DISTINCT s) AS distinctSupplierCount\nORDER BY distinctSupplierCount DESC\nLIMIT 10\nRETURN c.companyName AS customerName, distinctSupplierCount", "out_tokens": 73, "stop": "stop"}, {"raw": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[:ORDERS]->(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, count(DISTINCT s) AS numSuppliers\nORDER BY numSuppliers DESC\nRETURN c.companyName, numSuppliers\nLIMIT 10<|eot|>", "text": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[:ORDERS]->(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, count(DISTINCT s) AS numSuppliers\nORDER BY numSuppliers DESC\nRETURN c.companyName, numSuppliers\nLIMIT 10", "out_tokens": 70, "stop": "stop"}, {"raw": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[:ORDERS]->(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, COUNT(DISTINCT s) AS distinct_suppliers\nORDER BY distinct_suppliers DESC\nLIMIT 10\nRETURN c.companyName AS customer, distinct_suppliers<|eot|>", "text": "MATCH (c:Customer)-[:PURCHASED]->(o:Order)-[:ORDERS]->(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, COUNT(DISTINCT s) AS distinct_suppliers\nORDER BY distinct_suppliers DESC\nLIMIT 10\nRETURN c.companyName AS customer, distinct_suppliers", "out_tokens": 72, "stop": "stop"}], "in_tokens": 412, "api_error": null}
{"id": "tr424", "cands": [{"raw": "MATCH (writer:Person {born: 1949})-[:WROTE]->(movie:Movie)<-[:ACTED_IN]-(actor:Person)\nRETURN actor.name<|eot|>", "text": "MATCH (writer:Person {born: 1949})-[:WROTE]->(movie:Movie)<-[:ACTED_IN]-(actor:Person)\nRETURN actor.name", "out_tokens": 37, "stop": "stop"}, {"raw": "MATCH (p1:Person {born: 1949})-[:WROTE]->(m:Movie)<-[:ACTED_IN]-(p2:Person)\nRETURN p2.name, m.title<|eot|>", "text": "MATCH (p1:Person {born: 1949})-[:WROTE]->(m:Movie)<-[:ACTED_IN]-(p2:Person)\nRETURN p2.name, m.title", "out_tokens": 43, "stop": "stop"}, {"raw": "MATCH (p:Person {born: 1949})-[:WROTE]->(m:Movie)\nMATCH (actor:Person)-[:ACTED_IN]->(m)\nRETURN actor.name<|eot|>", "text": "MATCH (p:Person {born: 1949})-[:WROTE]->(m:Movie)\nMATCH (actor:Person)-[:ACTED_IN]->(m)\nRETURN actor.name", "out_tokens": 40, "stop": "stop"}, {"raw": "MATCH (m:Movie)<-[:WROTE]-(writer:Person {born: 1949})\nMATCH (actor:Person)-[:ACTED_IN]->(m)\nRETURN actor.name<|eot|>", "text": "MATCH (m:Movie)<-[:WROTE]-(writer:Person {born: 1949})\nMATCH (actor:Person)-[:ACTED_IN]->(m)\nRETURN actor.name", "out_tokens": 40, "stop": "stop"}], "in_tokens": 379, "api_error": null}
{"id": "tr425", "cands": [{"raw": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWITH d, max(m.released) AS last_movie_year\nWITH d, last_movie_year, d.born AS born_year\nWITH d, last_movie_year - born_year AS time_gap\nORDER BY time_gap DESC\nLIMIT 1\nMATCH (d)-[:DIRECTED]->(m:Movie {released: last_movie_year})\nRETURN m.title, time_gap<|eot|>", "text": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWITH d, max(m.released) AS last_movie_year\nWITH d, last_movie_year, d.born AS born_year\nWITH d, last_movie_year - born_year AS time_gap\nORDER BY time_gap DESC\nLIMIT 1\nMATCH (d)-[:DIRECTED]->(m:Movie {released: last_movie_year})\nRETURN m.title, time_gap", "out_tokens": 90, "stop": "stop"}, {"raw": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWITH d, m\nORDER BY m.released DESC\nWITH d, head(collect(m)) AS lastMovie\nWITH d, lastMovie, lastMovie.released - d.born AS gap\nORDER BY gap DESC\nRETURN lastMovie.title AS movieTitle, d.name AS directorName, gap AS timeGap\nLIMIT 1<|eot|>", "text": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWITH d, m\nORDER BY m.released DESC\nWITH d, head(collect(m)) AS lastMovie\nWITH d, lastMovie, lastMovie.released - d.born AS gap\nORDER BY gap DESC\nRETURN lastMovie.title AS movieTitle, d.name AS directorName, gap AS timeGap\nLIMIT 1", "out_tokens": 83, "stop": "stop"}, {"raw": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWITH d, m\nORDER BY m.released DESC\nWITH d, m, m.released - d.born AS gap\nWITH d, max(gap) AS max_gap\nORDER BY max_gap DESC\nRETURN d.name AS director, max_gap\nLIMIT 1<|eot|>", "text": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)\nWITH d, m\nORDER BY m.released DESC\nWITH d, m, m.released - d.born AS gap\nWITH d, max(gap) AS max_gap\nORDER BY max_gap DESC\nRETURN d.name AS director, max_gap\nLIMIT 1", "out_tokens": 71, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWITH p, m, (m.released - p.born) AS time_gap\nWITH p, max(time_gap) AS max_gap\nORDER BY max_gap DESC\nRETURN p.name AS director_name, max_gap AS time_gap<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWITH p, m, (m.released - p.born) AS time_gap\nWITH p, max(time_gap) AS max_gap\nORDER BY max_gap DESC\nRETURN p.name AS director_name, max_gap AS time_gap", "out_tokens": 62, "stop": "stop"}], "in_tokens": 386, "api_error": null}
{"id": "tr426", "cands": [{"raw": "MATCH (me:Me {screen_name: \"neo4j\"})-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(rtweet:Tweet)-[:MENTIONS]->(user:User)\nWITH user, count(rtweet) AS retweetCount\nORDER BY retweetCount DESC\nLIMIT 3\nRETURN user.name, retweetCount<|eot|>", "text": "MATCH (me:Me {screen_name: \"neo4j\"})-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(rtweet:Tweet)-[:MENTIONS]->(user:User)\nWITH user, count(rtweet) AS retweetCount\nORDER BY retweetCount DESC\nLIMIT 3\nRETURN user.name, retweetCount", "out_tokens": 74, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:RT_MENTIONS]->(user:User)\nRETURN user.screen_name, count(*) AS retweet_count\nORDER BY retweet_count DESC\nLIMIT 3<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:RT_MENTIONS]->(user:User)\nRETURN user.screen_name, count(*) AS retweet_count\nORDER BY retweet_count DESC\nLIMIT 3", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweetedTweet:Tweet)-[:MENTIONS]->(mentionedUser:User)\nRETURN mentionedUser.screen_name AS mentionedUser, COUNT(retweetedTweet) AS retweetsCount\nORDER BY retweetsCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweetedTweet:Tweet)-[:MENTIONS]->(mentionedUser:User)\nRETURN mentionedUser.screen_name AS mentionedUser, COUNT(retweetedTweet) AS retweetsCount\nORDER BY retweetsCount DESC\nLIMIT 3", "out_tokens": 78, "stop": "stop"}, {"raw": "MATCH (n:Me {screen_name: 'neo4j'})-[:RT_MENTIONS]->(u:User)\nWITH u, count(*) AS retweetCount\nRETURN u.screen_name, retweetCount\nORDER BY retweetCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (n:Me {screen_name: 'neo4j'})-[:RT_MENTIONS]->(u:User)\nWITH u, count(*) AS retweetCount\nRETURN u.screen_name, retweetCount\nORDER BY retweetCount DESC\nLIMIT 3", "out_tokens": 55, "stop": "stop"}], "in_tokens": 837, "api_error": null}
{"id": "tr427", "cands": [{"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweeted_tweet:Tweet)<-[:POSTS]-(author:User)\nWHERE author.profile_image_url ENDS WITH 'normal.jpg'\nRETURN retweeted_tweet\nLIMIT 3<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweeted_tweet:Tweet)<-[:POSTS]-(author:User)\nWHERE author.profile_image_url ENDS WITH 'normal.jpg'\nRETURN retweeted_tweet\nLIMIT 3", "out_tokens": 70, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(retweeted_tweet:Tweet)-[:RETWEETS]->(original_tweet:Tweet)<-[:POSTS]-(user:User)\nWHERE user.profile_image_url ENDS WITH 'normal.jpg'\nRETURN original_tweet\nORDER BY original_tweet.created_at ASC\nLIMIT 3<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(retweeted_tweet:Tweet)-[:RETWEETS]->(original_tweet:Tweet)<-[:POSTS]-(user:User)\nWHERE user.profile_image_url ENDS WITH 'normal.jpg'\nRETURN original_tweet\nORDER BY original_tweet.created_at ASC\nLIMIT 3", "out_tokens": 79, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(rt:Tweet)-[:RETWEETS]->(orig:Tweet)<-[:POSTS]-(poster:User)\nWHERE poster.profile_image_url ENDS WITH 'normal.jpg'\nRETURN rt, orig, poster\nORDER BY rt.created_at ASC\nLIMIT 3<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(rt:Tweet)-[:RETWEETS]->(orig:Tweet)<-[:POSTS]-(poster:User)\nWHERE poster.profile_image_url ENDS WITH 'normal.jpg'\nRETURN rt, orig, poster\nORDER BY rt.created_at ASC\nLIMIT 3", "out_tokens": 73, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweetedTweet:Tweet)<-[:POSTS]-(user:User)\nWHERE user.profile_image_url ENDS WITH 'normal.jpg'\nRETURN retweetedTweet\nORDER BY tweet.created_at\nLIMIT 3<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)-[:RETWEETS]->(retweetedTweet:Tweet)<-[:POSTS]-(user:User)\nWHERE user.profile_image_url ENDS WITH 'normal.jpg'\nRETURN retweetedTweet\nORDER BY tweet.created_at\nLIMIT 3", "out_tokens": 74, "stop": "stop"}], "in_tokens": 851, "api_error": null}
{"id": "tr428", "cands": [{"raw": "MATCH (t:Tweet)<-[:POSTS]-(u:User)\nWITH t, COUNT(u) AS popularity\nORDER BY popularity DESC\nLIMIT 1\nMATCH (t)-[:USING]->(s:Source)\nRETURN s.name AS source_name<|eot|>", "text": "MATCH (t:Tweet)<-[:POSTS]-(u:User)\nWITH t, COUNT(u) AS popularity\nORDER BY popularity DESC\nLIMIT 1\nMATCH (t)-[:USING]->(s:Source)\nRETURN s.name AS source_name", "out_tokens": 52, "stop": "stop"}, {"raw": "MATCH (t:Tweet)\nWITH t\nORDER BY t.favorites DESC\nLIMIT 3\nMATCH (t)-[:USING]->(s:Source)\nRETURN s.name AS source_name, t.favorites AS favorites<|eot|>", "text": "MATCH (t:Tweet)\nWITH t\nORDER BY t.favorites DESC\nLIMIT 3\nMATCH (t)-[:USING]->(s:Source)\nRETURN s.name AS source_name, t.favorites AS favorites", "out_tokens": 44, "stop": "stop"}, {"raw": "MATCH (t:Tweet)-[:USING]->(s:Source)\nWHERE t.favorites IS NOT NULL\nRETURN s.name AS source_name\nORDER BY t.favorites DESC\nLIMIT 3<|eot|>", "text": "MATCH (t:Tweet)-[:USING]->(s:Source)\nWHERE t.favorites IS NOT NULL\nRETURN s.name AS source_name\nORDER BY t.favorites DESC\nLIMIT 3", "out_tokens": 39, "stop": "stop"}, {"raw": "MATCH (t:Tweet)-[:USING]->(s:Source)\nWITH t, s, t.favorites AS favorites\nORDER BY favorites DESC\nLIMIT 3\nRETURN s.name AS source_name, favorites<|eot|>", "text": "MATCH (t:Tweet)-[:USING]->(s:Source)\nWITH t, s, t.favorites AS favorites\nORDER BY favorites DESC\nLIMIT 3\nRETURN s.name AS source_name, favorites", "out_tokens": 42, "stop": "stop"}], "in_tokens": 833, "api_error": null}
