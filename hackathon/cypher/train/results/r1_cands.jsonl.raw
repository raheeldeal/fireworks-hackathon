{"id": "tr468", "cands": [{"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH o, rel\nORDER BY toFloat(rel.discount) DESC\nLIMIT 3\nRETURN o.orderID AS orderID, rel.discount AS discount<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH o, rel\nORDER BY toFloat(rel.discount) DESC\nLIMIT 3\nRETURN o.orderID AS orderID, rel.discount AS discount", "out_tokens": 47, "stop": "stop"}, {"raw": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nRETURN o.orderID AS OrderID, r.discount AS Discount\nORDER BY toFloat(r.discount) DESC\nLIMIT 3<|eot|>", "text": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nRETURN o.orderID AS OrderID, r.discount AS Discount\nORDER BY toFloat(r.discount) DESC\nLIMIT 3", "out_tokens": 42, "stop": "stop"}, {"raw": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nRETURN o.orderID, r.discount\nORDER BY r.discount DESC\nLIMIT 3<|eot|>", "text": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nRETURN o.orderID, r.discount\nORDER BY r.discount DESC\nLIMIT 3", "out_tokens": 34, "stop": "stop"}, {"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH o, MAX(toFloat(rel.discount)) AS maxDiscount\nORDER BY maxDiscount DESC\nLIMIT 3\nRETURN o.orderID, maxDiscount<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH o, MAX(toFloat(rel.discount)) AS maxDiscount\nORDER BY maxDiscount DESC\nLIMIT 3\nRETURN o.orderID, maxDiscount", "out_tokens": 47, "stop": "stop"}], "in_tokens": 1254, "api_error": null}
