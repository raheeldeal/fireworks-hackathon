{"id": "tr315", "cands": [{"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c.categoryID AS categoryID, avg(p.unitPrice) AS avgPrice\nMATCH (p:Product)-[:PART_OF]->(c:Category)\nWHERE p.unitPrice > avgPrice AND c.categoryID = categoryID\nRETURN p.productName<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c.categoryID AS categoryID, avg(p.unitPrice) AS avgPrice\nMATCH (p:Product)-[:PART_OF]->(c:Category)\nWHERE p.unitPrice > avgPrice AND c.categoryID = categoryID\nRETURN p.productName", "out_tokens": 66, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, avg(p.unitPrice) AS avgPrice\nMATCH (p:Product)-[:PART_OF]->(c)\nWHERE p.unitPrice > avgPrice\nRETURN p.productName<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, avg(p.unitPrice) AS avgPrice\nMATCH (p:Product)-[:PART_OF]->(c)\nWHERE p.unitPrice > avgPrice\nRETURN p.productName", "out_tokens": 52, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWITH p.categoryID AS categoryId, avg(p.unitPrice) AS avgPrice\nWITH categoryId, avgPrice\nMATCH (p:Product {categoryID: categoryId})\nWHERE p.unitPrice > avgPrice\nRETURN p.productName<|eot|>", "text": "MATCH (p:Product)\nWITH p.categoryID AS categoryId, avg(p.unitPrice) AS avgPrice\nWITH categoryId, avgPrice\nMATCH (p:Product {categoryID: categoryId})\nWHERE p.unitPrice > avgPrice\nRETURN p.productName", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, avg(p.unitPrice) AS averagePrice\nMATCH (p:Product)-[:PART_OF]->(c)\nWHERE p.unitPrice > averagePrice\nRETURN p.productName<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, avg(p.unitPrice) AS averagePrice\nMATCH (p:Product)-[:PART_OF]->(c)\nWHERE p.unitPrice > averagePrice\nRETURN p.productName", "out_tokens": 52, "stop": "stop"}], "in_tokens": 1267, "api_error": null}
