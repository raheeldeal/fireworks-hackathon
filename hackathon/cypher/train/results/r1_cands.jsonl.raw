{"id": "tr181", "cands": [{"raw": "MATCH (director:Person)-[:DIRECTED]->(movie:Movie)<-[:REVIEWED]-(reviewer:Person)\nWHERE movie.released >= 1980 AND movie.released <= 2000\nWITH director, avg(review.rated) AS averageRating\nRETURN director.name AS directorName, averageRating\nORDER BY averageRating DESC\nLIMIT 1<|eot|>", "text": "MATCH (director:Person)-[:DIRECTED]->(movie:Movie)<-[:REVIEWED]-(reviewer:Person)\nWHERE movie.released >= 1980 AND movie.released <= 2000\nWITH director, avg(review.rated) AS averageRating\nRETURN director.name AS directorName, averageRating\nORDER BY averageRating DESC\nLIMIT 1", "out_tokens": 75, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)<-[r:REVIEWED]-()\nWHERE m.released >= 1980 AND m.released <= 2000\nWITH p, avg(r.rating) AS avgRating\nRETURN p.name AS Director, avgRating\nORDER BY avgRating DESC\nLIMIT 1<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)<-[r:REVIEWED]-()\nWHERE m.released >= 1980 AND m.released <= 2000\nWITH p, avg(r.rating) AS avgRating\nRETURN p.name AS Director, avgRating\nORDER BY avgRating DESC\nLIMIT 1", "out_tokens": 69, "stop": "stop"}, {"raw": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)<-[r:REVIEWED]-()\nWHERE m.released >= 1980 AND m.released <= 2000\nWITH d, AVG(r.rating) AS avg_rating\nRETURN d.name AS director, avg_rating\nORDER BY avg_rating DESC\nLIMIT 1<|eot|>", "text": "MATCH (d:Person)-[:DIRECTED]->(m:Movie)<-[r:REVIEWED]-()\nWHERE m.released >= 1980 AND m.released <= 2000\nWITH d, AVG(r.rating) AS avg_rating\nRETURN d.name AS director, avg_rating\nORDER BY avg_rating DESC\nLIMIT 1", "out_tokens": 69, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)<-[r:REVIEWED]-()\nWHERE m.released >= 1980 AND m.released <= 2000\nWITH p, avg(r.rating) AS average_rating\nORDER BY average_rating DESC\nRETURN p.name AS director, average_rating\nLIMIT 1<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)<-[r:REVIEWED]-()\nWHERE m.released >= 1980 AND m.released <= 2