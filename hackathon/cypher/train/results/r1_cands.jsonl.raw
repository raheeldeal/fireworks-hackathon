{"id": "tr130", "cands": [{"raw": "MATCH (toyStory:Movie {title: 'Toy Story'})\nMATCH (toyStory)<-[r1:RATED]-(:User)\nWITH collect(r1.user) AS users\nMATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE u IN users\nWITH m, avg(r.rating) AS avgRating\nORDER BY avgRating DESC\nRETURN m.title, avgRating\nLIMIT 1<|eot|>", "text": "MATCH (toyStory:Movie {title: 'Toy Story'})\nMATCH (toyStory)<-[r1:RATED]-(:User)\nWITH collect(r1.user) AS users\nMATCH (u:User)-[r:RATED]->(m:Movie)\nWHERE u IN users\nWITH m, avg(r.rating) AS avgRating\nORDER BY avgRating DESC\nRETURN m.title, avgRating\nLIMIT 1", "out_tokens": 84, "stop": "stop"}, {"raw": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (user:User)-[r:RATED]->(toyStory)\nMATCH (user)-[r2:RATED]->(otherMovie:Movie)\nWITH otherMovie, avg(r2.rating) AS averageRating\nORDER BY averageRating DESC\nRETURN otherMovie.title AS highestRatedMovie, averageRating\nLIMIT 1<|eot|>", "text": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (user:User)-[r:RATED]->(toyStory)\nMATCH (user)-[r2:RATED]->(otherMovie:Movie)\nWITH otherMovie, avg(r2.rating) AS averageRating\nORDER BY averageRating DESC\nRETURN otherMovie.title AS highestRatedMovie, averageRating\nLIMIT 1", "out_tokens": 78, "stop": "stop"}, {"raw": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[r1:RATED]-(user:User)\nWITH user\nMATCH (user)-[r2:RATED]->(movie:Movie)\nWHERE movie <> toyStory\nWITH movie, r2.rating AS rating\nORDER BY rating DESC\nRETURN movie.title AS title, rating\nLIMIT 1<|eot|>", "text": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[r1:RATED]-(user:User)\nWITH user\nMATCH (user)-[r2:RATED]->(movie:Movie)\nWHERE movie <> toyStory\nWITH movie, r2.rating AS rating\nORDER BY rating DESC\nRETURN movie.title AS title, rating\nLIMIT 1", "out_tokens": 78, "stop": "stop"}, {"raw": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[r:RATED]-(user:User)\nWITH user\nMATCH (user)-[r2:RATED]->(movie:Movie)\nWHERE movie <> toyStory\nWITH movie, avg(r2.rating) AS averageRating\nORDER BY averageRating DESC\nRETURN movie.title AS MovieTitle, averageRating\nLIMIT 1<|eot|>", "text": "MATCH (toyStory:Movie {title: \"Toy Story\"})\nMATCH (toyStory)<-[r:RATED]-(user:User)\nWITH user\nMATCH (user)-[r2:RATED]->(movie:Movie)\nWHERE movie <> toyStory\nWITH movie, avg(r2.rating) AS averageRating\nORDER BY averageRating DESC\nRETURN movie.title AS MovieTitle, averageRating\nLIMIT 1", "out_tokens": 83, "stop": "stop"}], "in_tokens": 1091, "api_error": null}
{"id": "tr131", "cands": [{"raw": "MATCH (p:Product)\nWHERE p.unitsInStock IS NOT NULL AND p.reorderLevel IS NOT NULL\nRETURN p.productName, p.unitsInStock, p.reorderLevel, abs(p.unitsInStock - p.reorderLevel) AS difference\nORDER BY difference ASC\nLIMIT 1<|eot|>", "text": "MATCH (p:Product)\nWHERE p.unitsInStock IS NOT NULL AND p.reorderLevel IS NOT NULL\nRETURN p.productName, p.unitsInStock, p.reorderLevel, abs(p.unitsInStock - p.reorderLevel) AS difference\nORDER BY difference ASC\nLIMIT 1", "out_tokens": 60, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWHERE p.unitsInStock >= p.reorderLevel\nWITH p, p.unitsInStock - p.reorderLevel AS difference\nORDER BY difference ASC\nRETURN p.productName, difference\nLIMIT 1<|eot|>", "text": "MATCH (p:Product)\nWHERE p.unitsInStock >= p.reorderLevel\nWITH p, p.unitsInStock - p.reorderLevel AS difference\nORDER BY difference ASC\nRETURN p.productName, difference\nLIMIT 1", "out_tokens": 47, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWITH p, abs(p.unitsInStock - p.reorderLevel) AS diff\nORDER BY diff ASC\nRETURN p.productName, p.unitsInStock, p.reorderLevel, diff\nLIMIT 1<|eot|>", "text": "MATCH (p:Product)\nWITH p, abs(p.unitsInStock - p.reorderLevel) AS diff\nORDER BY diff ASC\nRETURN p.productName, p.unitsInStock, p.reorderLevel, diff\nLIMIT 1", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWITH p, abs(p.unitsInStock - p.reorderLevel) AS difference\nORDER BY difference ASC\nRETURN p\nLIMIT 1<|eot|>", "text": "MATCH (p:Product)\nWITH p, abs(p.unitsInStock - p.reorderLevel) AS difference\nORDER BY difference ASC\nRETURN p\nLIMIT 1", "out_tokens": 34, "stop": "stop"}], "in_tokens": 1262, "api_error": null}
