{"id": "tr305", "cands": [{"raw": "MATCH (d:Director)-[:DIRECTED]->(m1:Movie)-[:IN_GENRE]->(g1:Genre {name: 'Animation'})\nWITH d, collect(DISTINCT m1) AS animatedMovies\nMATCH (d)-[:DIRECTED]->(m2:Movie)-[:IN_GENRE]->(g2:Genre)\nWHERE g2.name <> 'Animation'\nWITH d, count(DISTINCT m2) AS nonAnimatedCount, animatedMovies\nWHERE nonAnimatedCount > 0\nRETURN d.name AS director, size(animatedMovies) AS animatedMovieCount, nonAnimatedCount\nORDER BY animatedMovieCount DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m1:Movie)-[:IN_GENRE]->(g1:Genre {name: 'Animation'})\nWITH d, collect(DISTINCT m1) AS animatedMovies\nMATCH (d)-[:DIRECTED]->(m2:Movie)-[:IN_GENRE]->(g2:Genre)\nWHERE g2.name <> 'Animation'\nWITH d, count(DISTINCT m2) AS nonAnimatedCount, animatedMovies\nWHERE nonAnimatedCount > 0\nRETURN d.name AS director, size(animatedMovies) AS animatedMovieCount, nonAnimatedCount\nORDER BY animatedMovieCount DESC\nLIMIT 3", "out_tokens": 134, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE 'Animation' IN genres AND size(genres) > 1\nRETURN d.name AS director\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE 'Animation' IN genres AND size(genres) > 1\nRETURN d.name AS director\nLIMIT 3", "out_tokens": 62, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name IN ['Animation', 'Adventure'] // Example genres, replace with actual genre names\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE size(genres) > 1 AND 'Animation' IN genres AND 'Adventure' IN genres\nRETURN d.name AS directorName, genres\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)-[:IN_GENRE]->(g:Genre)\nWHERE g.name IN ['Animation', 'Adventure'] // Example genres, replace with actual genre names\nWITH d, collect(DISTINCT g.name) AS genres\nWHERE size(genres) > 1 AND 'Animation' IN genres AND 'Adventure' IN genres\nRETURN d.name AS directorName, genres\nLIMIT 3", "out_tokens": 91, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m1:Movie)-[:IN_GENRE]->(g1:Genre {name: 'Animation'})\nWITH d\nMATCH (d)-[:DIRECTED]->(m2:Movie)-[:IN_GENRE]->(g2:Genre)\nWHERE g2.name <> 'Animation'\nWITH d, count(DISTINCT m1) AS animatedMovies, count(DISTINCT m2) AS nonAnimatedMovies\nWHERE animatedMovies > 0 AND nonAnimatedMovies > 0\nRETURN d.name, animatedMovies, nonAnimatedMovies\nORDER BY animatedMovies DESC, nonAnimatedMovies DESC\nLIMIT 3<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m1:Movie)-[:IN_GENRE]->(g1:Genre {name: 'Animation'})\nWITH d\nMATCH (d)-[:DIRECTED]->(m2:Movie)-[:IN_GENRE]->(g2:Genre)\nWHERE g2.name <> 'Animation'\nWITH d, count(DISTINCT m1) AS animatedMovies, count(DISTINCT m2) AS nonAnimatedMovies\nWHERE animatedMovies > 0 AND nonAnimatedMovies > 0\nRETURN d.name, animatedMovies, nonAnimatedMovies\nORDER BY animatedMovies DESC, nonAnimatedMovies DESC\nLIMIT 3", "out_tokens": 133, "stop": "stop"}], "in_tokens": 1090, "api_error": null}
{"id": "tr306", "cands": [{"raw": "MATCH (m:Movie)\nWHERE m.revenue > 1000000000\nWITH avg(m.budget) AS averageBudget\nRETURN averageBudget<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.revenue > 1000000000\nWITH avg(m.budget) AS averageBudget\nRETURN averageBudget", "out_tokens": 30, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.revenue > 1000000000\nRETURN avg(m.budget) AS average_budget<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.revenue > 1000000000\nRETURN avg(m.budget) AS average_budget", "out_tokens": 26, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.revenue > 1000000000\nWITH avg(m.budget) AS AverageBudget\nRETURN AverageBudget<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.revenue > 1000000000\nWITH avg(m.budget) AS AverageBudget\nRETURN AverageBudget", "out_tokens": 30, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.revenue > 1000000000\nRETURN avg(m.budget) AS average_budget<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.revenue > 1000000000\nRETURN avg(m.budget) AS average_budget", "out_tokens": 26, "stop": "stop"}], "in_tokens": 1093, "api_error": null}
{"id": "tr307", "cands": [{"raw": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWITH o.orderID AS orderID, SUM(toFloat(r.unitPrice) * r.quantity) AS totalOrderValue\nORDER BY totalOrderValue DESC\nRETURN orderID, totalOrderValue\nLIMIT 1<|eot|>", "text": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWITH o.orderID AS orderID, SUM(toFloat(r.unitPrice) * r.quantity) AS totalOrderValue\nORDER BY totalOrderValue DESC\nRETURN orderID, totalOrderValue\nLIMIT 1", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH o, sum(toFloat(rel.unitPrice) * rel.quantity) AS totalValue\nRETURN o.orderID AS orderID, totalValue\nORDER BY totalValue DESC\nLIMIT 1<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH o, sum(toFloat(rel.unitPrice) * rel.quantity) AS totalValue\nRETURN o.orderID AS orderID, totalValue\nORDER BY totalValue DESC\nLIMIT 1", "out_tokens": 55, "stop": "stop"}, {"raw": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWITH o, sum(toFloat(r.unitPrice) * r.quantity) AS totalOrderValue\nRETURN o.orderID AS orderID, totalOrderValue\nORDER BY totalOrderValue DESC\nLIMIT 1<|eot|>", "text": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWITH o, sum(toFloat(r.unitPrice) * r.quantity) AS totalOrderValue\nRETURN o.orderID AS orderID, totalOrderValue\nORDER BY totalOrderValue DESC\nLIMIT 1", "out_tokens": 58, "stop": "stop"}, {"raw": "MATCH (o:Order)-[oi:ORDERS]->(p:Product)\nWITH o, sum(toFloat(oi.unitPrice) * oi.quantity AS totalOrderValue\nRETURN o.orderID, totalOrderValue\nORDER BY totalOrderValue DESC\nLIMIT 1<|eot|>", "text": "MATCH (o:Order)-[oi:ORDERS]->(p:Product)\nWITH o, sum(toFloat(oi.unitPrice) * oi.quantity AS totalOrderValue\nRETURN o.orderID, totalOrderValue\nORDER BY totalOrderValue DESC\nLIMIT 1", "out_tokens": 55, "stop": "stop"}], "in_tokens": 1272, "api_error": null}
{"id": "tr308", "cands": [{"raw": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)\nWHERE t.created_at >= datetime('2020-01-01T00:00:00Z') AND t.created_at <= datetime('2020-12-31T23:59:59Z')\nRETURN t.text, t.favorites\nORDER BY t.favorites DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)\nWHERE t.created_at >= datetime('2020-01-01T00:00:00Z') AND t.created_at <= datetime('2020-12-31T23:59:59Z')\nRETURN t.text, t.favorites\nORDER BY t.favorites DESC\nLIMIT 3", "out_tokens": 84, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)\nWHERE t.created_at >= datetime('2020-01-01T00:00:00Z') AND t.created_at < datetime('2021-01-01T00:00:00Z')\nRETURN t.text AS tweet_text, t.favorites AS favorites_count\nORDER BY t.favorites DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)\nWHERE t.created_at >= datetime('2020-01-01T00:00:00Z') AND t.created_at < datetime('2021-01-01T00:00:00Z')\nRETURN t.text AS tweet_text, t.favorites AS favorites_count\nORDER BY t.favorites DESC\nLIMIT 3", "out_tokens": 90, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)\nWHERE t.created_at >= datetime('2020-01-01T00:00:00Z') AND t.created_at < datetime('2021-01-01T00:00:00Z')\nRETURN t.text, t.favorites\nORDER BY t.favorites DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)\nWHERE t.created_at >= datetime('2020-01-01T00:00:00Z') AND t.created_at < datetime('2021-01-01T00:00:00Z')\nRETURN t.text, t.favorites\nORDER BY t.favorites DESC\nLIMIT 3", "out_tokens": 84, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})\nMATCH (me)-[:POSTS]->(tweet:Tweet)\nWHERE tweet.created_at >= date('2020-01-01') AND tweet.created_at < date('2021-01-01')\nRETURN tweet.text AS tweet_text, tweet.favorites AS favorites\nORDER BY favorites DESC\nLIMIT 3<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})\nMATCH (me)-