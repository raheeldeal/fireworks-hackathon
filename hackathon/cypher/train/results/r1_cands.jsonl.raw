{"id": "tr215", "cands": [{"raw": "MATCH (c:Category)<-[:PART_OF]-(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c.categoryName AS category, count(DISTINCT s.supplierID) AS supplierCount\nWHERE supplierCount > 3\nRETURN category, supplierCount<|eot|>", "text": "MATCH (c:Category)<-[:PART_OF]-(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c.categoryName AS category, count(DISTINCT s.supplierID) AS supplierCount\nWHERE supplierCount > 3\nRETURN category, supplierCount", "out_tokens": 59, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, count(DISTINCT p.supplierID) AS supplierCount\nWHERE supplierCount > 3\nRETURN c.categoryName AS CategoryName, supplierCount<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, count(DISTINCT p.supplierID) AS supplierCount\nWHERE supplierCount > 3\nRETURN c.categoryName AS CategoryName, supplierCount", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (c:Category)<-[:PART_OF]-(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, count(DISTINCT s) AS numSuppliers\nWHERE numSuppliers > 3\nRETURN c.categoryName, numSuppliers<|eot|>", "text": "MATCH (c:Category)<-[:PART_OF]-(p:Product)<-[:SUPPLIES]-(s:Supplier)\nWITH c, count(DISTINCT s) AS numSuppliers\nWHERE numSuppliers > 3\nRETURN c.categoryName, numSuppliers", "out_tokens": 57, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:SUPPLIES]-(s:Supplier)-[:SUPPLIES]->(p)\nWITH p.categoryID AS categoryID, count(DISTINCT s.supplierID) AS supplierCount\nWHERE supplierCount > 3\nRETURN categoryID<|eot|>", "text": "MATCH (p:Product)-[:SUPPLIES]-(s:Supplier)-[:SUPPLIES]->(p)\nWITH p.categoryID AS categoryID, count(DISTINCT s.supplierID) AS supplierCount\nWHERE supplierCount > 3\nRETURN categoryID", "out_tokens": 55, "stop": "stop"}], "in_tokens": 1256, "api_error": null}
{"id": "tr216", "cands": [{"raw": "MATCH (m:Movie)\nWHERE m.released IS NOT NULL AND date(m.released).dayOfWeek = 5\nRETURN m.title, m.released\nORDER BY m.released DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.released IS NOT NULL AND date(m.released).dayOfWeek = 5\nRETURN m.title, m.released\nORDER BY m.released DESC\nLIMIT 3", "out_tokens": 44, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.released IS NOT NULL\n  AND apoc.date.weekday(m.released) = 5\nRETURN m.title, m.released\nORDER BY m.imdbRating DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.released IS NOT NULL\n  AND apoc.date.weekday(m.released) = 5\nRETURN m.title, m.released\nORDER BY m.imdbRating DESC\nLIMIT 3", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE date(m.released).dayOfWeek = 5\nRETURN m.title, m.released\nORDER BY m.released DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)\nWHERE date(m.released).dayOfWeek = 5\nRETURN m.title, m.released\nORDER BY m.released DESC\nLIMIT 3", "out_tokens": 37, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.released IS NOT NULL\n  AND apoc.date.format(toInteger(apoc.date.parse(m.released, 'ms', 'yyyy-MM-dd')), 'ms', 'E') = 'Fri'\nRETURN m.title, m.released\nORDER BY m.released DESC\nLIMIT 3<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.released IS NOT NULL\n  AND apoc.date.format(toInteger(apoc.date.parse(m.released, 'ms', 'yyyy-MM-dd')), 'ms', 'E') = 'Fri'\nRETURN m.title, m.released\nORDER BY m.released DESC\nLIMIT 3", "out_tokens": 66, "stop": "stop"}], "in_tokens": 1090, "api_error": null}
