{"id": "tr410", "cands": [{"raw": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWITH o.orderID AS orderID, COUNT(r) AS productsPerOrder\nWITH avg(productsPerOrder) AS averageProductsPerOrder\nRETURN averageProductsPerOrder<|eot|>", "text": "MATCH (o:Order)-[r:ORDERS]->(p:Product)\nWITH o.orderID AS orderID, COUNT(r) AS productsPerOrder\nWITH avg(productsPerOrder) AS averageProductsPerOrder\nRETURN averageProductsPerOrder", "out_tokens": 50, "stop": "stop"}, {"raw": "MATCH (o:Order)-[:ORDERS]->(p:Product)\nWITH o, count(p) AS productsPerOrder\nRETURN avg(productsPerOrder) AS averageProductsPerOrder<|eot|>", "text": "MATCH (o:Order)-[:ORDERS]->(p:Product)\nWITH o, count(p) AS productsPerOrder\nRETURN avg(productsPerOrder) AS averageProductsPerOrder", "out_tokens": 37, "stop": "stop"}, {"raw": "MATCH (o:Order)-[:ORDERS]->(p:Product)\nWITH o, count(p) AS productsPerOrder\nRETURN avg(productsPerOrder) AS averageProductsPerOrder<|eot|>", "text": "MATCH (o:Order)-[:ORDERS]->(p:Product)\nWITH o, count(p) AS productsPerOrder\nRETURN avg(productsPerOrder) AS averageProductsPerOrder", "out_tokens": 37, "stop": "stop"}, {"raw": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH o.orderID AS orderID, count(p) AS numProducts\nWITH avg(numProducts) AS avgProductsPerOrder\nRETURN avgProductsPerOrder<|eot|>", "text": "MATCH (o:Order)-[rel:ORDERS]->(p:Product)\nWITH o.orderID AS orderID, count(p) AS numProducts\nWITH avg(numProducts) AS avgProductsPerOrder\nRETURN avgProductsPerOrder", "out_tokens": 48, "stop": "stop"}], "in_tokens": 1255, "api_error": null}
{"id": "tr411", "cands": [{"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, COUNT(p) AS stockedProducts, COUNT{(s)-[:SUPPLIES]->(p)} AS totalProducts\nWHERE stockedProducts = totalProducts\nRETURN s.companyName AS SupplierName\nLIMIT 5<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nWITH s, COUNT(p) AS stockedProducts, COUNT{(s)-[:SUPPLIES]->(p)} AS totalProducts\nWHERE stockedProducts = totalProducts\nRETURN s.companyName AS SupplierName\nLIMIT 5", "out_tokens": 69, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:SUPPLIES]-(s:Supplier)\nWHERE p.unitsInStock > 0\nRETURN DISTINCT s.companyName\nLIMIT 5<|eot|>", "text": "MATCH (p:Product)-[:SUPPLIES]-(s:Supplier)\nWHERE p.unitsInStock > 0\nRETURN DISTINCT s.companyName\nLIMIT 5", "out_tokens": 34, "stop": "stop"}, {"raw": "MATCH (p:Product)\nWHERE p.unitsInStock >= p.reorderLevel\nWITH p.supplierID AS supplierID\nMATCH (s:Supplier {supplierID: supplierID})\nRETURN s.companyName, s.contactName, s.city, s.country\nLIMIT 5<|eot|>", "text": "MATCH (p:Product)\nWHERE p.unitsInStock >= p.reorderLevel\nWITH p.supplierID AS supplierID\nMATCH (s:Supplier {supplierID: supplierID})\nRETURN s.companyName, s.contactName, s.city, s.country\nLIMIT 5", "out_tokens": 56, "stop": "stop"}, {"raw": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nRETURN s.companyName AS supplierName\nORDER BY s.companyName\nLIMIT 5<|eot|>", "text": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)\nWHERE p.unitsInStock > 0\nRETURN s.companyName AS supplierName\nORDER BY s.companyName\nLIMIT 5", "out_tokens": 42, "stop": "stop"}], "in_tokens": 1259, "api_error": null}
{"id": "tr412", "cands": [{"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWHERE m.released < 1980\nWITH p.born AS birthYear, m.released AS movieYear\nWITH avg(movieYear - birthYear) AS averageAge\nRETURN averageAge<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWHERE m.released < 1980\nWITH p.born AS birthYear, m.released AS movieYear\nWITH avg(movieYear - birthYear) AS averageAge\nRETURN averageAge", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWHERE m.released < 1980\nWITH p, m\nRETURN avg(1979 - p.born) AS average_age<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWHERE m.released < 1980\nWITH p, m\nRETURN avg(1979 - p.born) AS average_age", "out_tokens": 42, "stop": "stop"}, {"raw": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWHERE m.released < 1980\nWITH p, m.released - p.born AS age\nRETURN avg(age) AS average_age<|eot|>", "text": "MATCH (p:Person)-[:DIRECTED]->(m:Movie)\nWHERE m.released < 1980\nWITH p, m.released - p.born AS age\nRETURN avg(age) AS average_age", "out_tokens": 44, "stop": "stop"}, {"raw": "MATCH (:Movie {released: <1980})<-[:DIRECTED]-(director:Person)\nWITH avg(1980 - director.born) AS average_age\nRETURN average_age<|eot|>", "text": "MATCH (:Movie {released: <1980})<-[:DIRECTED]-(director:Person)\nWITH avg(1980 - director.born) AS average_age\nRETURN average_age", "out_tokens": 37, "stop": "stop"}], "in_tokens": 378, "api_error": null}
