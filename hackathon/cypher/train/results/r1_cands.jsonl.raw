{"id": "tr364", "cands": [{"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)\nMATCH (tweet)<-[:RETWEETS]-(:Tweet)<-[:POSTS]-(user:User)\nWHERE user.followers > 10000\nRETURN tweet.text AS tweet_text, tweet.favorites AS favorites\nORDER BY favorites DESC\nLIMIT 3<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)\nMATCH (tweet)<-[:RETWEETS]-(:Tweet)<-[:POSTS]-(user:User)\nWHERE user.followers > 10000\nRETURN tweet.text AS tweet_text, tweet.favorites AS favorites\nORDER BY favorites DESC\nLIMIT 3", "out_tokens": 77, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)\nMATCH (t)<-[:RETWEETS]-(retweetedBy:User)\nWHERE retweetedBy.followers > 10000\nRETURN t.text AS tweet_text, retweetedBy.screen_name AS retweeted_by\nORDER BY t.created_at DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)\nMATCH (t)<-[:RETWEETS]-(retweetedBy:User)\nWHERE retweetedBy.followers > 10000\nRETURN t.text AS tweet_text, retweetedBy.screen_name AS retweeted_by\nORDER BY t.created_at DESC\nLIMIT 3", "out_tokens": 83, "stop": "stop"}, {"raw": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)<-[:RETWEETS]-(:User {followers: > 10000})\nRETURN tweet.text AS tweet_text\nLIMIT 3<|eot|>", "text": "MATCH (me:Me {screen_name: 'neo4j'})-[:POSTS]->(tweet:Tweet)<-[:RETWEETS]-(:User {followers: > 10000})\nRETURN tweet.text AS tweet_text\nLIMIT 3", "out_tokens": 51, "stop": "stop"}, {"raw": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)<-[:RETWEETS]-(:Tweet)<-[:POSTS]-(retweeter:User)\nWHERE retweeter.followers > 10000\nRETURN t\nORDER BY t.favorites DESC\nLIMIT 3<|eot|>", "text": "MATCH (u:User {screen_name: 'neo4j'})-[:POSTS]->(t:Tweet)<-[:RETWEETS]-(:Tweet)<-[:POSTS]-(retweeter:User)\nWHERE retweeter.followers > 10000\nRETURN t\nORDER BY t.favorites DESC\nLIMIT 3", "out_tokens": 69, "stop": "stop"}], "in_tokens": 844, "api_error": null}
