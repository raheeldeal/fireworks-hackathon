{"id": "tr397", "cands": [{"raw": "MATCH (m:Movie)\nWHERE m.votes = (MATCH (n:Movie) RETURN MAX(n.votes))[0]\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nRETURN p.name, r.roles<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.votes = (MATCH (n:Movie) RETURN MAX(n.votes))[0]\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nRETURN p.name, r.roles", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWITH m\nORDER BY m.votes DESC\nLIMIT 1\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nRETURN p.name AS actor, r.roles AS roles<|eot|>", "text": "MATCH (m:Movie)\nWITH m\nORDER BY m.votes DESC\nLIMIT 1\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nRETURN p.name AS actor, r.roles AS roles", "out_tokens": 46, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.votes IS NOT NULL\nWITH m\nORDER BY m.votes DESC\nLIMIT 1\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nRETURN p.name AS actor, r.roles AS roles<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.votes IS NOT NULL\nWITH m\nORDER BY m.votes DESC\nLIMIT 1\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nRETURN p.name AS actor, r.roles AS roles", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWITH m\nORDER BY m.votes DESC\nLIMIT 1\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nRETURN p.name AS actor, r.roles AS roles<|eot|>", "text": "MATCH (m:Movie)\nWITH m\nORDER BY m.votes DESC\nLIMIT 1\nMATCH (p:Person)-[r:ACTED_IN]->(m)\nRETURN p.name AS actor, r.roles AS roles", "out_tokens": 46, "stop": "stop"}], "in_tokens": 379, "api_error": null}
