{"id": "tr006", "cands": [{"raw": "MATCH (f:Filing)-[:BENEFITS]->(be:Entity)-[:COUNTRY]->(c:Country {code: \"GBR\"})\nWHERE f.amount > 1000000\nWITH avg(f.amount) AS average_amount\nRETURN average_amount<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(be:Entity)-[:COUNTRY]->(c:Country {code: \"GBR\"})\nWHERE f.amount > 1000000\nWITH avg(f.amount) AS average_amount\nRETURN average_amount", "out_tokens": 52, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)-[:COUNTRY]->(c:Country)\nWHERE c.code = \"GBR\" AND f.amount > 1000000\nWITH avg(f.amount) AS average_amount\nRETURN average_amount<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)-[:COUNTRY]->(c:Country)\nWHERE c.code = \"GBR\" AND f.amount > 1000000\nWITH avg(f.amount) AS average_amount\nRETURN average_amount", "out_tokens": 54, "stop": "stop"}, {"raw": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)-[:COUNTRY]->(c:Country {code: \"GBR\"})\nWHERE f.amount > 1000000\nRETURN avg(f.amount) AS average_amount<|eot|>", "text": "MATCH (f:Filing)-[:BENEFITS]->(e:Entity)-[:COUNTRY]->(c:Country {code: \"GBR\"})\nWHERE f.amount > 1000000\nRETURN avg(f.amount) AS average_amount", "out_tokens": 48, "stop": "stop"}, {"raw": "MATCH (filing:Filing)-[:BENEFITS]->(entity:Entity)-[:COUNTRY]->(country:Country)\nWHERE country.code = \"GBR\" AND filing.amount > 1000000\nWITH avg(filing.amount) AS averageAmount\nRETURN averageAmount<|eot|>", "text": "MATCH (filing:Filing)-[:BENEFITS]->(entity:Entity)-[:COUNTRY]->(country:Country)\nWHERE country.code = \"GBR\" AND filing.amount > 1000000\nWITH avg(filing.amount) AS averageAmount\nRETURN averageAmount", "out_tokens": 56, "stop": "stop"}], "in_tokens": 740, "api_error": null}
{"id": "tr007", "cands": [{"raw": "MATCH (m:Movie)\nWHERE m.released >= '1990-01-01' AND m.released < '2000-01-01'\nRETURN m.title, m.revenue\nORDER BY m.revenue DESC\nLIMIT 5<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.released >= '1990-01-01' AND m.released < '2000-01-01'\nRETURN m.title, m.revenue\nORDER BY m.revenue DESC\nLIMIT 5", "out_tokens": 50, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.year >= 1990 AND m.year < 2000\nRETURN m.title, m.revenue\nORDER BY m.revenue DESC\nLIMIT 5<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.year >= 1990 AND m.year < 2000\nRETURN m.title, m.revenue\nORDER BY m.revenue DESC\nLIMIT 5", "out_tokens": 39, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.year >= 1990 AND m.year < 2000 AND m.revenue IS NOT NULL\nRETURN m.title AS Movie, m.revenue AS Revenue\nORDER BY m.revenue DESC\nLIMIT 5<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.year >= 1990 AND m.year < 2000 AND m.revenue IS NOT NULL\nRETURN m.title AS Movie, m.revenue AS Revenue\nORDER BY m.revenue DESC\nLIMIT 5", "out_tokens": 50, "stop": "stop"}, {"raw": "MATCH (m:Movie)\nWHERE m.year >= 1990 AND m.year < 2000\nRETURN m.title, m.revenue\nORDER BY m.revenue DESC\nLIMIT 5<|eot|>", "text": "MATCH (m:Movie)\nWHERE m.year >= 1990 AND m.year < 2000\nRETURN m.title, m.revenue\nORDER BY m.revenue DESC\nLIMIT 5", "out_tokens": 39, "stop": "stop"}], "in_tokens": 1096, "api_error": null}
{"id": "tr008", "cands": [{"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, avg(p.unitPrice) AS avgPrice\nORDER BY avgPrice DESC\nLIMIT 5\nRETURN c.categoryName, avgPrice<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, avg(p.unitPrice) AS avgPrice\nORDER BY avgPrice DESC\nLIMIT 5\nRETURN c.categoryName, avgPrice", "out_tokens": 44, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c.categoryName AS category, avg(p.unitPrice) AS averagePrice\nORDER BY averagePrice DESC\nLIMIT 5\nRETURN category, averagePrice<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c.categoryName AS category, avg(p.unitPrice) AS averagePrice\nORDER BY averagePrice DESC\nLIMIT 5\nRETURN category, averagePrice", "out_tokens": 46, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c.categoryName AS category, avg(p.unitPrice) AS avgPrice\nORDER BY avgPrice DESC\nLIMIT 5\nRETURN category, avgPrice<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c.categoryName AS category, avg(p.unitPrice) AS avgPrice\nORDER BY avgPrice DESC\nLIMIT 5\nRETURN category, avgPrice", "out_tokens": 46, "stop": "stop"}, {"raw": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, avg(p.unitPrice) AS avgPrice\nORDER BY avgPrice DESC\nLIMIT 5\nRETURN c.categoryName AS category, avgPrice<|eot|>", "text": "MATCH (p:Product)-[:PART_OF]->(c:Category)\nWITH c, avg(p.unitPrice) AS avgPrice\nORDER BY avgPrice DESC\nLIMIT 5\nRETURN c.categoryName AS category, avgPrice", "out_tokens": 46, "stop": "stop"}], "in_tokens": 1258, "api_error": null}
{"id": "tr009", "cands": [{"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)<-[r:RATED]-()\nWITH d, max(r.rating) AS maxRating, min(r.rating) AS minRating\nWITH d, maxRating - minRating AS ratingDiff\nRETURN d.name AS director, ratingDiff\nORDER BY ratingDiff DESC\nLIMIT 1<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)<-[r:RATED]-()\nWITH d, max(r.rating) AS maxRating, min(r.rating) AS minRating\nWITH d, maxRating - minRating AS ratingDiff\nRETURN d.name AS director, ratingDiff\nORDER BY ratingDiff DESC\nLIMIT 1", "out_tokens": 70, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)<-[r:RATED]-()\nWITH d, max(r.rating) AS maxRating, min(r.rating) AS minRating\nRETURN d.name AS director, maxRating - minRating AS ratingDifference\nORDER BY ratingDifference DESC\nLIMIT 1<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)<-[r:RATED]-()\nWITH d, max(r.rating) AS maxRating, min(r.rating) AS minRating\nRETURN d.name AS director, maxRating - minRating AS ratingDifference\nORDER BY ratingDifference DESC\nLIMIT 1", "out_tokens": 64, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)<-[r:RATED]-()\nWITH d, m, max(r.rating) AS highestRating, min(r.rating) AS lowestRating\nWITH d, highestRating - lowestRating AS ratingDifference\nRETURN d.name AS director, ratingDifference\nORDER BY ratingDifference DESC\nLIMIT 1<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)<-[r:RATED]-()\nWITH d, m, max(r.rating) AS highestRating, min(r.rating) AS lowestRating\nWITH d, highestRating - lowestRating AS ratingDifference\nRETURN d.name AS director, ratingDifference\nORDER BY ratingDifference DESC\nLIMIT 1", "out_tokens": 72, "stop": "stop"}, {"raw": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)<-[r:RATED]-()\nWITH d, max(r.rating) AS maxRating, min(r.rating) AS minRating\nWITH d, maxRating - minRating AS ratingRange\nRETURN d.name AS director, ratingRange\nORDER BY ratingRange DESC\nLIMIT 1<|eot|>", "text": "MATCH (d:Director)-[:DIRECTED]->(m:Movie)<-[r:RATED]-()\nWITH d, max(r.rating) AS maxRating, min(r.rating) AS minRating\nWITH d, maxRating - minRating AS ratingRange\nRETURN d.name AS director, ratingRange\nORDER BY ratingRange DESC\nLIMIT 1", "out_tokens": 70, "stop": "stop"}], "in_tokens": 1090, "api_error": null}
